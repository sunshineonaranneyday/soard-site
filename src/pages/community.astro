---
/**
 * Community Projects — Sunshine on a Ranney Day
 * Large-scale renovations at schools, camps, and nonprofits
 * serving children with special needs.
 *
 * DESIGN: Magazine-style editorial layouts — each project gets its own
 * visual moment. Alternating splits, immersive hero cards, color panels.
 * No two sections look the same.
 *
 * PERF NOTES:
 * - Editorial split hero (no full-bleed image)
 * - Hero image: fetchpriority="high", eager loading, LQIP blur-up
 * - All below-fold images: loading="lazy" with LQIP
 * - CFImage component for responsive srcsets
 * - data-reveal on below-fold elements
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CFImage from '../components/ui/CFImage.astro';
import { getWebPageSchema, getBreadcrumbSchema, buildSchemaGraph } from '../utils/schema';
import { getCollection } from 'astro:content';
import { cfRaw, cfSrcset, cfLqip, CF_BASE as CF } from '../utils/cf-image';
import { getSiteStats } from '../utils/stats';
import siteSettings from '../content/site/settings.json';

/* ── Community Projects from content collection ── */
const allProjects = await getCollection('community');
const projects = allProjects
  .map(p => p.data)
  .sort((a, b) => parseInt(a.year) - parseInt(b.year));

const { livesImpacted } = await getSiteStats();
const totalImpact = livesImpacted.toLocaleString() + '+';

/* ── Separate projects by type ── */
const inProgress = projects.find(p => p.badge === 'In Progress');
const completed = projects.filter(p => p.badge !== 'In Progress');
const withPhotos = completed.filter(p => p.imageId);
const withoutPhotos = completed.filter(p => !p.imageId);

/* ── Hero photo (from admin settings, with fallback) ── */
const cp = siteSettings.communityPhotos || {};
const heroProject = completed.find(p => p.slug === 'camp-twin-lakes') || withPhotos[0];
const heroPhotoId = cp.hero || heroProject?.imageId || 'kids/camp-twin-lakes/hero';

/* ── Schema ── */
const pageUrl = 'https://sunshineonaranneyday.com/community/';
const breadcrumbs = [
  { name: 'Home', url: 'https://sunshineonaranneyday.com/' },
  { name: 'Community Projects', url: pageUrl },
];
const jsonLd = buildSchemaGraph(
  getWebPageSchema({
    url: pageUrl,
    title: 'Community Projects',
    description: 'Sunshine on a Ranney Day partners with nonprofits, schools, and camps to complete large-scale renovation projects that impact thousands of children with special needs each year.',
  }),
  getBreadcrumbSchema(breadcrumbs, pageUrl),
);
---

<BaseLayout
  title="Community Projects — Large-Scale Renovations"
  description="Sunshine on a Ranney Day partners with nonprofits, schools, and camps to complete large-scale renovation projects that impact thousands of children with special needs each year."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <!-- Preload hero LCP image — srcset/sizes must match the <img> -->
  <link slot="head" rel="preload" as="image" imagesrcset={`${CF}/${heroPhotoId}/w=400,h=500,fit=cover,q=65 400w, ${CF}/${heroPhotoId}/w=560,h=700,fit=cover,q=65 560w, ${CF}/${heroPhotoId}/w=800,h=1000,fit=cover,q=65 800w`} imagesizes="(max-width:768px) 85vw, 420px" fetchpriority="high" />

  <!-- ══════ HERO — Editorial Split ══════ -->
  <section class="hero" aria-label="Community Projects">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow">Community Projects</p>
        <h1 class="hero-headline">Thinking <em>bigger</em>.</h1>
        <p class="hero-lead">When one room isn't enough, we think bigger. We partner with schools, camps, and nonprofits to transform entire facilities — classrooms, therapy rooms, and gathering spaces that serve thousands of children every year.</p>
        <div class="hero-ctas">
          <a href="#projects" class="btn btn-primary">See Our Partners</a>
          <a href="/donate" class="btn btn-dark">Donate Today</a>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-frame" style={`background-image:url('${cfLqip(heroPhotoId)}')`}>
          <img
            src={`${CF}/${heroPhotoId}/w=800,h=1000,fit=cover,q=65`}
            srcset={`${CF}/${heroPhotoId}/w=400,h=500,fit=cover,q=65 400w, ${CF}/${heroPhotoId}/w=560,h=700,fit=cover,q=65 560w, ${CF}/${heroPhotoId}/w=800,h=1000,fit=cover,q=65 800w`}
            sizes="(max-width:768px) 85vw, 420px"
            alt="Camp Twin Lakes facility renovated by SOARD"
            width="800" height="1000"
            fetchpriority="high"
            loading="eager"
            decoding="sync"
            class="hero-img lqip-img"
          />
        </div>
        <div class="hero-accent" aria-hidden="true"></div>
        <div class="hero-stat">
          <span class="hero-stat-num" aria-label={`${totalImpact} children reached`}>{totalImpact}</span>
          <span class="hero-stat-label">children reached<br/>through partnerships</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ IMPACT RIBBON ══════ -->
  <section class="cp-ribbon" aria-label="Community project impact">
    <div class="cp-ribbon-inner">
      <div class="cp-ribbon-stat" data-reveal>
        <span class="cp-ribbon-num">{projects.length}</span>
        <span class="cp-ribbon-label">Major<br/>Partners</span>
      </div>
      <div class="cp-ribbon-divider" role="presentation"></div>
      <div class="cp-ribbon-stat" data-reveal data-delay="1">
        <span class="cp-ribbon-num">10+</span>
        <span class="cp-ribbon-label">Years of<br/>Impact</span>
      </div>
      <div class="cp-ribbon-divider" role="presentation"></div>
      <div class="cp-ribbon-stat" data-reveal data-delay="2">
        <span class="cp-ribbon-num">100<span class="cp-ribbon-pct">%</span></span>
        <span class="cp-ribbon-label">Volunteer<br/>Driven</span>
      </div>
      <div class="cp-ribbon-divider" role="presentation"></div>
      <div class="cp-ribbon-stat" data-reveal data-delay="3">
        <span class="cp-ribbon-num">$0</span>
        <span class="cp-ribbon-label">Cost to<br/>Organizations</span>
      </div>
    </div>
  </section>

  <!-- ══════ CURRENTLY BUILDING — In-Progress Feature ══════ -->
  {inProgress && (
    <section class="cp-building" aria-label="Current project">
      <div class="cp-building-inner" data-reveal>
        <div class="cp-building-content">
          <div class="cp-building-badge">
            <span class="cp-building-dot" aria-hidden="true"></span>
            Currently Building
          </div>
          <span class="cp-building-year">{inProgress.year}</span>
          <h2 class="cp-building-name">{inProgress.name}</h2>
          <p class="cp-building-desc">{inProgress.description}</p>
          <div class="cp-building-impact">
            <span class="cp-building-impact-num">{inProgress.impact}</span>
            <span class="cp-building-impact-label">{inProgress.impactLabel}</span>
          </div>
        </div>
        <div class="cp-building-visual" aria-hidden="true">
          <div class="cp-building-graphic">
            <span class="cp-building-graphic-num">{inProgress.impact}</span>
            <span class="cp-building-graphic-label">{inProgress.impactLabel}</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ══════ PROJECTS — Magazine Editorial ══════ -->
  <section class="cp-projects" id="projects" aria-labelledby="projects-heading">
    <div class="cp-projects-header" data-reveal>
      <div class="section-label">Our Partners</div>
      <h2 id="projects-heading">Organizations we've <em class="highlight">transformed</em>.</h2>
      <p class="cp-projects-sub">Each partnership is a story of transformation — facilities redesigned, spaces reimagined, and thousands of lives changed.</p>
    </div>

    <!-- Lead project — full-width immersive card -->
    {heroProject && (
      <div class="cp-feature" data-reveal>
        <div class="cp-feature-img" style={`background-image:url(${cfLqip(heroProject.imageId)})`}>
          <CFImage
            src={heroProject.imageId}
            alt={heroProject.imageAlt || `${heroProject.name} renovation by SOARD`}
            width={1200} height={600}
            sizes="(max-width:768px) 100vw, 80vw"
            widths={[600, 900, 1200]}
            loading="lazy"
            fit="cover"
            class="lqip-img"
          />
        </div>
        <div class="cp-feature-scrim"></div>
        <div class="cp-feature-body">
          <span class="cp-feature-year">{heroProject.year}</span>
          <h3 class="cp-feature-name">{heroProject.name}</h3>
          <p class="cp-feature-desc">{heroProject.description}</p>
          <div class="cp-feature-impact">
            <span class="cp-feature-impact-num">{heroProject.impact}</span>
            <span class="cp-feature-impact-label">{heroProject.impactLabel}</span>
          </div>
        </div>
      </div>
    )}

    <!-- Remaining projects — alternating editorial splits -->
    <div class="cp-stories">
      {completed.filter(p => p.slug !== heroProject?.slug).map((project, i) => (
        <article class={`cp-story ${i % 2 === 1 ? 'cp-story--reversed' : ''}`} data-reveal>
          {project.imageId ? (
            <div class="cp-story-visual">
              <div class="cp-story-frame" style={`background-image:url(${cfLqip(project.imageId)})`}>
                <CFImage
                  src={project.imageId}
                  alt={project.imageAlt || `${project.name} renovation by SOARD`}
                  width={700} height={500}
                  sizes="(max-width:768px) 90vw, 45vw"
                  widths={[400, 600, 700]}
                  loading="lazy"
                  fit="cover"
                  class="lqip-img"
                />
              </div>
            </div>
          ) : (
            <div class="cp-story-visual">
              <div class="cp-story-color" style={`background: ${project.color};`}>
                <span class="cp-story-color-num">{project.impact}</span>
                <span class="cp-story-color-label">{project.impactLabel}</span>
              </div>
            </div>
          )}
          <div class="cp-story-content">
            <span class="cp-story-year">{project.year}</span>
            {project.badge && <span class="cp-story-badge">{project.badge}</span>}
            <h3 class="cp-story-name">{project.name}</h3>
            <div class="cp-story-impact">
              <span class="cp-story-impact-num">{project.impact}</span>
              <span class="cp-story-impact-label">{project.impactLabel}</span>
            </div>
            <p class="cp-story-desc">{project.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════ QUOTE ══════ -->
  <section class="cp-quote" aria-label="Quote">
    <div class="cp-quote-inner" data-reveal>
      <blockquote>
        <p>"These large-scale community projects have helped <em>thousands</em> of families in their most stressful time."</p>
        <footer>
          <strong>Peter Ranney</strong>, Co-Founder
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ══════ FINAL CTA ══════ -->
  <section class="cp-finale">
    <div class="cp-finale-inner">
      <h2 data-reveal>Help us build the <em>next</em> community project.</h2>
      <p data-reveal data-delay="1">Every donation funds large-scale renovations at schools, camps, and nonprofits across greater Atlanta.</p>
      <div class="cp-finale-ctas" data-reveal data-delay="2">
        <a href="/donate" class="btn btn-dark btn-lg">Donate Today</a>
        <a href="/kids" class="btn cp-btn-outline-dark">Meet the Kids</a>
      </div>
      <p class="cp-finale-note" data-reveal data-delay="3">501(c)(3) · EIN 45-4773997 · All donations tax-deductible</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── LQIP blur-up ── */
  .lqip-img.lqip-pending { opacity: 0; }
  .lqip-img:not(.lqip-pending) { transition: opacity 0.4s ease; }

  /* ══════════════════════════════════════════
     HERO — Editorial Split
     Standardized hero-* naming (matches home/apply/donate)
     ══════════════════════════════════════════ */
  .hero {
    position: relative;
    background: var(--c-cream);
    contain: layout style;
    padding: clamp(40px, 8vh, 100px) 0 40px;
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--max-width-wide, 1400px);
    margin: 0 auto;
    padding: 0 var(--page-padding);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    min-height: clamp(480px, 70vh, 720px);
  }

  /* ── Text column ── */
  .hero-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-light);
    margin-bottom: 28px;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .hero-headline {
    font-size: clamp(42px, 6.5vw, 88px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--c-dark);
    margin-bottom: 28px;
    /* NO opacity:0 — this is the LCP element, must paint immediately */
    animation: heroSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-headline em {
    font-style: italic;
    background-image: linear-gradient(transparent 52%, var(--c-yellow-soft) 52%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    padding: 0 0.05em;
  }

  .hero-lead {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.7;
    color: var(--c-text-muted);
    max-width: 480px;
    margin-bottom: 36px;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    opacity: 0;
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  /* ── Photo column — portrait (4:5), accent, stat badge ── */
  .hero-photo-wrap {
    position: relative;
    /* NO opacity:0 — hero image is LCP candidate, must paint on load */
    animation: heroPhotoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-frame {
    display: block;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.06);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-frame:hover img {
    transform: scale(1.03);
  }

  /* Yellow accent element behind the photo */
  .hero-accent {
    position: absolute;
    z-index: -1;
    bottom: -16px;
    right: -16px;
    width: 55%;
    height: 55%;
    border-radius: 20px;
    background: var(--c-yellow);
    opacity: 0.35;
  }

  /* Floating stat badge */
  .hero-stat {
    position: absolute;
    bottom: -24px;
    left: -24px;
    background: var(--c-dark);
    color: #fff;
    border-radius: 16px;
    padding: 20px 28px;
    text-align: center;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
    opacity: 0;
    animation: heroUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .hero-stat-num {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--c-yellow);
    line-height: 1;
    display: block;
  }

  .hero-stat-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 4px;
    line-height: 1.4;
  }

  @keyframes heroUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroSlide {
    from { transform: translateY(20px); }
    to { transform: translateY(0); }
  }
  @keyframes heroPhotoIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow, .hero-lead, .hero-ctas,
    .hero-photo-wrap, .hero-stat { opacity: 1; transform: none; animation: none; }
  }

  @media (max-width: 768px) {
    .hero { padding: clamp(32px, 6vh, 64px) 0 32px; }
    .hero-inner { grid-template-columns: 1fr; gap: var(--space-2xl); min-height: auto; }
    .hero-headline { font-size: clamp(36px, 9vw, 52px); }
    .hero-ctas { flex-direction: column; }
    .hero-ctas .btn { width: 100%; }
    .hero-accent { bottom: -12px; right: -12px; }
    .hero-stat { left: 16px; bottom: -16px; padding: 16px 22px; }
    .hero-stat-num { font-size: 32px; }
  }

  @media (max-width: 480px) {
    .hero-headline { font-size: clamp(32px, 8.5vw, 42px); }
    .hero-ctas .btn { padding: 12px 26px; font-size: 14px; }
  }

  /* ══════════════════════════════════════════
     IMPACT RIBBON
     ══════════════════════════════════════════ */
  .cp-ribbon {
    background: var(--c-dark);
    padding-block: clamp(40px, 6vh, 72px);
  }

  .cp-ribbon-inner {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl);
  }

  .cp-ribbon-stat { text-align: center; flex: 1; }

  .cp-ribbon-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 700;
    color: var(--c-yellow);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cp-ribbon-pct { font-size: 0.55em; vertical-align: super; }

  .cp-ribbon-label {
    display: block;
    margin-top: var(--space-sm);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
    font-weight: 600;
  }

  .cp-ribbon-divider {
    width: 1px;
    height: var(--space-3xl);
    background: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .cp-ribbon { padding-block: var(--space-2xl); }
    .cp-ribbon-inner { flex-wrap: wrap; gap: var(--space-xl) var(--space-md); }
    .cp-ribbon-stat { flex: 0 0 calc(50% - var(--space-md)); }
    .cp-ribbon-divider { display: none; }
  }

  /* ══════════════════════════════════════════
     CURRENTLY BUILDING — In-Progress Feature
     ══════════════════════════════════════════ */
  .cp-building {
    background: var(--c-cream);
    padding-block: var(--space-5xl);
  }

  .cp-building-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--page-padding, clamp(1rem, 4vw, 2rem));
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    background: var(--c-dark);
    border-radius: 24px;
    padding: clamp(40px, 6vw, 72px);
    position: relative;
    overflow: hidden;
  }

  .cp-building-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(255, 218, 36, 0.15);
    border: 1px solid rgba(255, 218, 36, 0.3);
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-yellow);
  }

  .cp-building-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-yellow);
    animation: cpPulse 2s ease-in-out infinite;
  }

  @keyframes cpPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }

  .cp-building-year {
    display: block;
    margin-top: var(--space-lg);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
  }

  .cp-building-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--c-white);
    line-height: 1.2;
    margin: var(--space-sm) 0 var(--space-lg);
  }

  .cp-building-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    max-width: 520px;
  }

  .cp-building-impact {
    margin-top: var(--space-xl);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .cp-building-impact-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--c-yellow);
    line-height: 1;
  }

  .cp-building-impact-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Right side — decorative graphic */
  .cp-building-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-building-graphic {
    text-align: center;
    padding: var(--space-3xl);
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 200px;
  }

  .cp-building-graphic-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.12);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cp-building-graphic-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.08);
    margin-top: var(--space-sm);
  }

  @media (max-width: 768px) {
    .cp-building { padding-block: var(--space-3xl); }
    .cp-building-inner {
      grid-template-columns: 1fr;
      padding: clamp(32px, 5vw, 48px);
    }
    .cp-building-visual { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-building-dot { animation: none; }
  }

  /* ══════════════════════════════════════════
     PROJECTS — Magazine Editorial Layout
     ══════════════════════════════════════════ */
  .cp-projects {
    padding-block: var(--space-5xl);
