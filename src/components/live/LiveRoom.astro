---
/**
 * LiveRoom.astro — the room and the plan, beside the video, on a computer
 * ========================================================================
 * The Theater layout (Peter, Nov 17 2026): during the watch party on a computer
 * the live page is three columns. The story on the left (the kid's name and
 * this), the video in the middle with its rail, the messages on the right.
 * This is the story's picture: one big picture of the room as it is, or the
 * plan, with a switch between them and the rest as small pictures in a column
 * beside it (Peter, Nov 18 2026: "why not have the plans in a vertical single
 * column with slider next to it? same for before photos?", picked C1). The big
 * one takes the column's height down to the buttons, about square at most.
 *
 *   [ The room before | The plan ]
 *   ┌─────────────────────┐ ▢     a click on a small one shows it big (the
 *   │ BEFORE              │ ▢     arrows up and down go through them); more
 *   │                     │ ▢     than fit scroll, faded at the edge that has
 *   │                     │ ▢     more. A click on the big one opens the design
 *   └─────────────────────┘ ▢     viewer beside the video (the reveal plays on)
 *   1 of 5 · click to see it big
 *
 * Previous and next on the big one's edges go through the part's pictures one at a time (Nov 20 2026), and so do the
 * left and right arrow keys on it.
 *
 * The plan's first picture is its compare (Peter, Nov 18 2026): the floor
 * plan today and the new one on one picture, a line between them to drag
 * (plan-compare.ts, compare-slider.ts), then the designer's two sheets, their
 * small pictures cut to the drawing (a whole sheet that small is white paper
 * with a speck on it).
 *
 * The same pictures and badges as the design section under the hero and the
 * viewer: live-design.ts fills all three (createLiveDesign's room). Shown only
 * on a computer with an upright video during the watch party; a phone has the
 * design section under the video instead. Styles are global: the parts are
 * drawn by live-design.ts. Every class is lrm-.
 */
---

<section class="lrm" data-live-room hidden aria-labelledby="lrm-name">
  <h2 class="sr-only" id="lrm-name" data-lrm="name">The design</h2>
  <div class="lrm-tabs" role="tablist" aria-labelledby="lrm-name" data-lrm="tabs"></div>
  <div class="lrm-stage" id="lrm-stage" data-lrm="stage" role="tabpanel" aria-labelledby="lrm-name">
    <div class="lrm-row">
      <button class="lrm-big" type="button" data-lrm="big">
        <span class="lrm-pic" data-lrm="pic"></span>
        <span class="lrm-badge" data-lrm="badge" hidden></span>
      </button>
      <!-- The plan's compare, in the big picture's place when it's the one showing (live-design.ts fills it: drag the line;
           its corner button, or a click that isn't a drag, opens it big) -->
      <div class="lrm-cmp" data-lrm="cmp" hidden></div>
      <!-- Through the pictures one at a time, from the big one's edges (Peter, Nov 20 2026: "why arent there left and right
           toggle on the before images for users to easliy click through?"): round at the ends, the small ones' ring
           and the count following (live-design.ts). Only when the part showing has more than one -->
      <button class="lrm-nav lrm-nav--prev" type="button" data-lrm="prev" aria-label="Previous picture" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="lrm-nav lrm-nav--next" type="button" data-lrm="next" aria-label="Next picture" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      <ul class="lrm-thumbs" data-lrm="thumbs" aria-label="Pictures"></ul>
    </div>
    <p class="lrm-cap"><b data-lrm="cap"></b><span data-lrm="count"></span></p>
  </div>
</section>

<style is:global>
  /* Only in the Theater layout: a computer, an upright video, the watch party (LivePage), with pictures to show */
  .lrm { display: none; }
  /* (the Theater layout's width, LivePage: always a computer's layout, DESK in src/utils/live-media.ts) */
  @media (min-width: 1200px) {
    .hero[data-party][data-orientation='portrait'] .lrm:not([hidden]) { display: block; margin: 0 0 24px; animation: lrmIn 0.45s ease-out both; }
    @keyframes lrmIn { from { opacity: 0; } }
  }
  /* The switch: the room, the plan, the look (whichever have pictures). A sliding toggle (Peter, Nov 19 2026: "the room
     before and the plan had a really great slider toggle"): the parts the same width on a soft track, and the one showing
     an ink pill that glides to the one picked (280 ms; at once for anyone who asked for less motion). Ink, not yellow:
     the Theater's one yellow is Fund the next room */
  .lrm-tabs {
    --n: 1; --i: 0;
    position: relative; display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; align-self: flex-start;
    padding: 4px; margin: 0 0 14px; max-width: 100%; border-radius: 100px; background: #F2EFE7;
  }
  .lrm-tabs:has(> :nth-child(2):last-child) { --n: 2; }
  .lrm-tabs:has(> :nth-child(3):last-child) { --n: 3; }
  .lrm-tabs:has(> :nth-child(2)[aria-selected='true']) { --i: 1; }
  .lrm-tabs:has(> :nth-child(3)[aria-selected='true']) { --i: 2; }
  .lrm-tabs::before {
    content: ''; position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / var(--n)); border-radius: 100px;
    background: var(--c-dark); box-shadow: 0 2px 8px rgba(30, 31, 37, 0.18);
    transform: translateX(calc(var(--i) * 100%)); transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lrm-tabs[hidden], .lrm-thumbs[hidden] { display: none; }
  .lrm-tab {
    position: relative; z-index: 1; height: 36px; padding: 0 18px; border: 0; border-radius: 100px; background: transparent; color: var(--c-text-muted);
    font: inherit; font-size: 14px; font-weight: 700; white-space: nowrap; cursor: pointer; transition: color 200ms ease;
  }
  .lrm-tab:hover { color: var(--c-text); }
  .lrm-tab[aria-selected='true'] { color: #fff; }
  .lrm-tab:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  /* The picture: a photo fills its card; a plan sits whole on its white paper. Still: it's beside a video, and nothing
     next to the reveal moves but the reveal */
  .lrm-big {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; border-radius: 18px; overflow: hidden; cursor: zoom-in;
    background: var(--c-warm-gray); box-shadow: 0 1px 2px rgba(30, 31, 37, 0.06), 0 0 0 1px rgba(30, 31, 37, 0.05);
  }
  .lrm-big:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 3px; }
  /* (the compare in its place: gone, not just covered) */
  .lrm-big[hidden] { display: none; }
  .lrm-pic { position: absolute; inset: 0; display: block; }
  .lrm-pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 360ms ease; }
  .lrm-pic img.is-in { opacity: 1; }
  /* (the one it replaces goes at once, so a badge never sits on the wrong picture; its small picture stands in) */
  .lrm-pic img.is-out { opacity: 0; transition-duration: 120ms; }
  .lrm-pic img.is-stand { opacity: 1; transition: none; }
  .lrm-big[data-paper] { background: #fff; }
  .lrm-big[data-paper] .lrm-pic img { object-fit: contain; padding: 12px; }
  .lrm-badge {
    position: absolute; top: 12px; left: 12px; z-index: 1; padding: 6px 10px 5px; border-radius: 8px;
    background: var(--c-dark); color: #fff; font-size: 11.5px; font-weight: 800; line-height: 1.1; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92), 0 6px 18px rgba(0, 0, 0, 0.2);
  }
  .lrm-badge[hidden] { display: none; }
  .lrm-badge[data-kind='proposed'] { background: var(--c-yellow); color: var(--c-dark); }
  .lrm-big[data-sheet] .lrm-badge { left: auto; right: 12px; }
  .lrm-cap { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 12px 2px; font-size: 13.5px; color: var(--c-text-muted); }
  .lrm-cap b { color: var(--c-text); font-weight: 700; }
  .lrm-cap b:empty { display: none; }
  .lrm-cap span { white-space: nowrap; }
  /* The big one and, beside it, the rest small in a column as tall as it (LivePage sizes the row in the story column) */
  .lrm { --lrm-rail: 76px; --lrm-gap: 10px; }
  .lrm-row { position: relative; display: flex; gap: var(--lrm-gap); align-items: stretch; }
  /* Previous and next: white circles on the big picture's left and right edges, half way down, clear of its badge
     (the next one left of the small ones' column when it shows: that column is the rail plus its gap, and 4px of its
     focus room past the row) */
  .lrm-nav {
    position: absolute; top: 50%; z-index: 2; width: 42px; height: 42px; margin-top: -21px; padding: 0; border: 0; border-radius: 50%;
    display: grid; place-items: center; background: rgba(255, 255, 255, 0.95); color: var(--c-dark); cursor: pointer;
    box-shadow: 0 0 0 1px rgba(30, 31, 37, 0.06), 0 6px 18px rgba(30, 31, 37, 0.18); transition: transform 160ms ease, background-color 160ms ease;
  }
  .lrm-nav[hidden] { display: none; }
  .lrm-nav svg { width: 20px; height: 20px; }
  .lrm-nav--prev { left: 12px; }
  .lrm-nav--prev svg { margin-left: -2px; }
  .lrm-nav--next { right: 12px; }
  .lrm-nav--next svg { margin-right: -2px; }
  .lrm-row:has(> .lrm-thumbs:not([hidden])) .lrm-nav--next { right: calc(var(--lrm-rail) + var(--lrm-gap) + 4px + 12px); }
  .lrm-nav:hover { background: #fff; transform: scale(1.06); }
  .lrm-nav:active { transform: scale(0.94); }
  .lrm-nav:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; box-shadow: 0 0 0 5px var(--c-yellow); }
  .lrm-row > .lrm-big, .lrm-row > .lrm-cmp { flex: 1 1 0; min-width: 0; }
  /* The rest, small: a click shows one big. Each as tall as a fifth of the column at most (five photos fit beside the
     picture), never shorter than 44px: more than fit scroll (no fade at the edge: a fade is a gradient, Peter's never). Its
     rings and focus need the 4px around them, so the column is 4px bigger each way than it looks */
  .lrm-thumbs {
    position: relative; flex: none; display: flex; flex-direction: column; gap: 8px; width: calc(var(--lrm-rail) + 8px);
    margin: -4px -4px -4px 0; padding: 4px; list-style: none; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none;
  }
  .lrm-thumbs::-webkit-scrollbar { display: none; }
  /* (a part with one picture: its column's place kept, empty) */
  .lrm-thumbs[data-one] { visibility: hidden; }
  .lrm-thumbs li { flex: 0 1 64px; min-height: 44px; display: flex; }
  .lrm-thumb {
    position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: 10px; overflow: hidden; cursor: pointer;
    background: #fff; box-shadow: 0 0 0 1px var(--c-border); transition: box-shadow 160ms ease, transform 160ms ease;
  }
  /* (all at full strength: a dimmed one reads as switched off; the one showing big has the ring) */
  .lrm-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* (a plan's: its drawing, cut to it, whole on white, and under it which it is, in its badge's colours) */
  .lrm-thumbs[data-paper] .lrm-thumb img { object-fit: contain; padding: 5px; }
  .lrm-thumbs[data-paper] .lrm-thumb:has(.lrm-thumb-tag) img { padding-bottom: 17px; }
  .lrm-thumb-tag {
    position: absolute; left: 50%; bottom: 4px; transform: translateX(-50%); padding: 2px 5px 1px; border-radius: 4px; white-space: nowrap; pointer-events: none;
    background: var(--c-dark); color: #fff; font-size: 8.5px; font-weight: 800; line-height: 1.2; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .lrm-thumb-tag[data-kind='proposed'] { background: var(--c-yellow); color: var(--c-dark); }
  /* The compare in the big picture's place: as big as the room allows at its own shape, centred */
  .lrm-cmp { position: relative; width: 100%; aspect-ratio: 4 / 3; container-type: size; display: grid; place-items: center; }
  .lrm-cmp[hidden] { display: none; }
  /* As big as the photo: the plan's card fills the same box the room's photo does, the drawing as big as it fits on it
     (Peter, Nov 18 2026: "theres more room on the left side we can use right?") */
  .lrm-cmp .pcmp {
    width: 100%; height: 100%; aspect-ratio: auto; border-radius: 18px;
    box-shadow: 0 1px 2px rgba(30, 31, 37, 0.06), 0 0 0 1px rgba(30, 31, 37, 0.06);
  }
  /* Its small picture: the two plans, half and half, with the line */
  .lrm-thumbs .lrm-thumb--cmp img { position: absolute; inset: 0; object-fit: contain; padding: 5px; background: #fff; }
  .lrm-thumb--cmp .lrm-half { clip-path: inset(0 50% 0 0); }
  .lrm-thumb--cmp::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--c-dark); }
  .lrm-thumb:hover { transform: translateY(-1px); }
  .lrm-thumb[aria-current='true'] { box-shadow: 0 0 0 2px var(--c-dark); }
  .lrm-thumb:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 1px; }
  @media (prefers-reduced-motion: reduce) {
    .lrm-pic img, .lrm-thumb, .lrm-thumb img, .lrm-tab, .lrm-tabs::before, .lrm-nav { transition: none; }
    .lrm-nav:hover, .lrm-nav:active { transform: none; }
    .lrm { animation: none !important; }
    .lrm-thumb:hover { transform: none; }
  }
</style>
