    :global(.hero[data-party]:has(:is([data-stage][data-rail], [data-stage][data-ended][data-orientation='portrait']))) .hero-party { grid-area: party; margin: 0; height: calc(var(--side-fh) - 36px); display: flex; flex-direction: column; min-height: 0; }
    :global(.hero[data-party]:has(:is([data-stage][data-rail], [data-stage][data-ended][data-orientation='portrait']))) .hero-status { display: none; }
    :global(.hero[data-party]:has(:is([data-stage][data-rail], [data-stage][data-ended][data-orientation='portrait']))) .hero-ctas { grid-area: ctas; margin-top: 20px; justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-text h1, .hero-lead, .hero-status, .hero-watch, .hero-ctas, .hero-frame { animation: none; opacity: 1; }
    .hero-eyebrow__dot::after, .hero-onair__dot::after { animation: none; }
    .hero[data-enter] :is(.hero-head, .hero-ctas, .hero-frame, .hero-party, :global(.lrm), :global(.lsp)), .hero :global(.lrm) { animation: none !important; }
  }
</style>

<script>
  import { getLiveClient, rehearsal, type LiveState, type ReminderOptions } from '../../utils/live-client';
  import { shareable } from '../../utils/live-stats';
  import { remindersUsable, browserCanPush, revealIsToday } from '../../utils/live-banner';
  import { holdPlace, keepFocus } from '../../utils/hold-place';
  import { upcomingAtBuild } from '../../utils/reveals-copy';
  import { wireRemindForm } from '../../utils/remind-signup';
  import { createStage } from '../../utils/live-stage';
  import { typingIn } from '../../utils/live-media';
  import { createMessages } from '../../utils/live-messages';
  import { createGive } from '../../utils/live-give';
  import { createLiveDesign } from '../../utils/live-design';
  import { openShareSheet } from '../../utils/share-sheet';
  import { cfRaw } from '../../utils/cf-image';
  import { readUpcoming, loadSignup, inviteData, inviteLinks, scheduleOnPage, type UpcomingReveal } from '../../utils/reveals-client';
  import { heroRowsHtml, rowsSignature, afterLine } from '../../utils/upcoming-rows';
  import { afterReveal, momentWords, betweenText, ctasThatApply, ctaPicks, remindParts, remindWords, leadSentences, watchWords } from '../../utils/live-hero-text';
  import { onPageLoad } from '../../utils/page-load';

  // The hero's buttons, two at most, and which apply when: src/utils/live-hero-text.ts (HERO_CTAS, ctasThatApply), shared
  // with the server, which shows the same two from the first paint

  const client = getLiveClient();
  // A staff rehearsal looks exactly as viewers will see it; only its tab says what it is (live-client.ts rehearsal)
  if (rehearsal && !document.title.startsWith('Rehearsal')) document.title = `Rehearsal · ${document.title}`;

  /**
   * The site navigates client-side (Astro ClientRouter), which runs this
   * module once per visit to the site, not once per visit to the page. So
   * the page sets itself up on every page that lands on it (onPageLoad), and
   * stops its video, timers and listeners when it is swapped out; otherwise
   * coming back to it (the Back button) would show a dead page.
   */
  let teardown: (() => void) | null = null;
  let firstPage = true; // the page the document loaded with (a reload or Back to it) rather than one the router swapped in
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = null; });
  onPageLoad(() => {
    teardown?.();
    teardown = null;
    const hero = document.getElementById('live-hero') as HTMLElement | null;
    const stageEl = hero?.querySelector<HTMLElement>('[data-stage]');
    if (hero && stageEl) teardown = setUp(hero, stageEl);
  });

  function setUp(hero: HTMLElement, stageEl: HTMLElement) {
    // The Theater's entrance plays once, as the page first draws (data-enter, above: the reveal, then the columns beside
    // it, done by 800 ms). Taken off after it, so nothing in the panel starts over when the page changes later: going live
    // glides into the Theater instead (morph)
    setTimeout(() => hero.removeAttribute('data-enter'), 900);
    const pageKid = hero.dataset.kid || '';
    // Set by functions/live/[[path]].js when /live/ was rendered for the current kid
    const followKid = hero.dataset.follow || '';
    const page = hero.closest('.live-page') as HTMLElement | null;
    const q = <T extends Element>(k: string) => hero.querySelector(`[data-live="${k}"]`) as T | null;
    const body = document.querySelector('.live-body') as HTMLElement | null;
    const bq = <T extends Element>(k: string) => body?.querySelector(`[data-live="${k}"]`) as T | null;
    const setHidden = (el: Element | null, hidden: boolean) => { if (el) (el as HTMLElement).hidden = hidden; };
    const setAttr = (el: HTMLElement, name: string, on: boolean) => { if (on) el.setAttribute(name, ''); else el.removeAttribute(name); };

    // ── The build's partners, scrolling under the frame (LivePartners.astro) ──
    // Each logo takes the same room whatever its shape once it has loaded (--r); one that won't load leaves the row,
    // both of its copies. The band shows only with the child it belongs to: /live/ following the next reveal, or
    // between reveals, has another child's (or nobody's) frame
    const band = hero.querySelector<HTMLElement>('[data-live-partners]');
    const bandHas = () => !!band?.querySelector('.lpb-chip');
    band?.querySelectorAll<HTMLImageElement>('img[data-lpb-logo]').forEach((img) => {
      const weigh = () => { if (img.naturalWidth && img.naturalHeight) img.style.setProperty('--r', (img.naturalWidth / img.naturalHeight).toFixed(3)); };
      const drop = () => {
        const src = img.getAttribute('src');
        band!.querySelectorAll<HTMLImageElement>('img[data-lpb-logo]').forEach((other) => { if (other.getAttribute('src') === src) other.closest('.lpb-chip')?.remove(); });
        if (!bandHas()) drawBand(shownKidNow);
      };
      img.addEventListener('load', weigh);
      img.addEventListener('error', drop);
      if (img.complete) { if (img.naturalWidth) weigh(); else if (img.getAttribute('src')) img.decode().then(weigh, () => { if (!img.naturalWidth) drop(); }); }
    });
    let shownKidNow = '';
    function drawBand(kidSlug: string) {
      shownKidNow = kidSlug;
      const on = !!band && !!kidSlug && band.dataset.kid === kidSlug && bandHas();
      setHidden(band, !on);
      setAttr(stageEl, 'data-partners', on);
      // (the sponsors' column too: only with the child it belongs to, and while it has a logo)
      setHidden(sponsorsEl, !(sponsorsEl && kidSlug && sponsorsEl.dataset.kid === kidSlug && sponsorsEl.querySelector('.lsp-card')));
    }

    // ── The build's sponsors by tier, the Theater's right column (LiveSponsors.astro) ──
    // Each logo the same area within its tier once it has loaded (--r); one that won't load leaves, and its tier with it
    // when it was the last
    const sponsorsEl = hero.querySelector<HTMLElement>('[data-live-sponsors]');
    sponsorsEl?.querySelectorAll<HTMLImageElement>('img[data-lsp-logo]').forEach((img) => {
      const weigh = () => { if (img.naturalWidth && img.naturalHeight) img.style.setProperty('--r', (img.naturalWidth / img.naturalHeight).toFixed(3)); };
      const drop = () => {
        const tier = img.closest('.lsp-tier');
        img.closest('.lsp-card')?.remove();
        if (tier && !tier.querySelector('.lsp-card')) tier.remove();
        drawBand(shownKidNow);
        fitSponsors();
      };
      img.addEventListener('load', weigh);
      img.addEventListener('error', drop);
      if (img.complete) { if (img.naturalWidth) weigh(); else if (img.getAttribute('src')) img.decode().then(weigh, () => { if (!img.naturalWidth) drop(); }); }
    });
    // Every card as tall as the column has room for (--lsp-s, LiveSponsors): the cards' heights are the only part that
    // scales, so the column's contents grow in a straight line with it; measured at two scales, the one that just fills
    // the column follows. Between 0.55 and 1.35 of the cards' set heights: a build with more sponsors than fit even at
    // the smallest scrolls, one with a few doesn't blow them up. Again whenever the column's size changes (shown, the
    // window resized; its contents never change its size: size containment) and when a logo leaves
    function fitSponsors() {
      const el = sponsorsEl;
      if (!el || !el.clientHeight || !el.firstElementChild) return;
      const cs = getComputedStyle(el);
      const room = el.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom) - 1;
      const used = (s: number) => {
        el.style.setProperty('--lsp-s', String(s));
        return el.lastElementChild!.getBoundingClientRect().bottom - el.firstElementChild!.getBoundingClientRect().top;
      };
      const at1 = used(1), per = used(2) - at1;
      const s = per > 0 ? Math.min(1.35, Math.max(0.55, 1 + (room - at1) / per)) : 1;
      el.style.setProperty('--lsp-s', s.toFixed(3));
    }
    if (sponsorsEl && 'ResizeObserver' in window) new ResizeObserver(fitSponsors).observe(sponsorsEl);
    document.fonts?.ready.then(fitSponsors);

    // ── The messages in the Theater: the newest two under the room until someone opens them ──
    // (LiveMessages: a message, "See all" or "Write to the family"; a tap on any brings the card to the right column in the
    // sponsors' place, data-msgs-open, its × or Escape puts them back. Only in the Theater with the sponsors' column)
    const theaterWide = matchMedia('(min-width: 1200px)');
    const compactMsgs = () => theaterWide.matches && hero.hasAttribute('data-party') && hero.dataset.orientation === 'portrait'
      && !!sponsorsEl && !sponsorsEl.hidden && !hero.hasAttribute('data-msgs-open');
    const openMsgs = (write: boolean) => {
      hero.setAttribute('data-msgs-open', '');
      // (once the card is laid out in its column: before, the box can't take the keyboard)
      requestAnimationFrame(() => {
        const box = hero.querySelector<HTMLTextAreaElement>('.hero-party textarea[name="body"]');
        const any = !!hero.querySelector('.hero-party [data-msgs="list"] > *');
        if ((write || !any) && box && box.getClientRects().length) box.focus({ preventScroll: true });
        else hero.querySelector<HTMLElement>('.hero-party [data-msgs="close"]')?.focus({ preventScroll: true });
      });
    };
    const closeMsgs = () => {
      if (!hero.hasAttribute('data-msgs-open')) return;
      hero.removeAttribute('data-msgs-open');
      // (back on whichever opened them that shows: See all, or Write when there are none yet to see)
      [...hero.querySelectorAll<HTMLElement>('.hero-party :is([data-msgs="all"], [data-msgs="write"])')].find((b) => b.getClientRects().length)?.focus({ preventScroll: true });
    };
    // (before the line's own tap, which on a phone goes down to the messages: here they come to the column instead)
    hero.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest?.('.hero-party [data-msgs="close"]')) { e.preventDefault(); closeMsgs(); return; }
      if (!compactMsgs()) return;
      const write = !!t.closest?.('.hero-party [data-msgs="write"]');
      if (!write && !t.closest?.('.hero-party :is([data-msgs="latest"], [data-msgs="all"], [data-msgs="list"] .msg)')) return;
      e.preventDefault();
      e.stopPropagation();
      openMsgs(write);
    }, true);
    hero.addEventListener('keydown', (e) => { if (e.key === 'Escape' && hero.hasAttribute('data-msgs-open') && (e.target as Element).closest?.('.hero-party')) closeMsgs(); });
    let last: LiveState | null = null;
    // The live broadcast's video, as last seen (the reveal's last seconds play on it after the broadcast moves on)
    let liveSeen: { id: string; player: NonNullable<LiveState['player']> } | null = null;
    let lastMeta: { reminders: ReminderOptions | null } = { reminders: null };
    let remindKid = ''; // who a sign-up here is for; empty means every reveal
    let remindNamed = ''; // the child the block names (its slug), whichever reveals they pick
    let remindShown = ''; // that child's name (empty: the block names nobody, and signs up for every reveal)
    const upNextBand = () => document.getElementById('up-next');
    // Someone who came for what's next (a link to /live/#up-next). The
    // browser looked for the band while the page was still laid out as built, often with it hidden: between reveals
    // the hero shows the same list instead. So go there now, to whichever is showing. Once, on arrival (not on Back).
    let upNextArrived = location.hash !== '#up-next' || (history.state?.scrollY || 0) > 0;
    function arriveAtUpNext() {
      if (upNextArrived) return;
      const shown = (el: HTMLElement | null) => (el && el.getBoundingClientRect().height > 0 ? el : null);
      const target = shown(upNextBand()) || shown(hero.querySelector<HTMLElement>('[data-hero-next]'));
      if (!target) return; // the next draw tries again
      upNextArrived = true;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    }

    // Whether the Coming up band is on screen (see the .live-next rule): the page going idle doesn't pull it from under someone
    const nextWrap = document.querySelector<HTMLElement>('.live-next');
    const bandSeen = nextWrap && 'IntersectionObserver' in window
      ? new IntersectionObserver(([e]) => { holdPlace(() => nextWrap.toggleAttribute('data-in-view', e.isIntersecting)); })
      : null;
    if (nextWrap) bandSeen?.observe(nextWrap);
    let display = 'loading';
    // The status line folding away (setStatus in drawPage)
    let statusFold: Animation | null = null;
    let shownKid = pageKid || followKid;
    let viewed = false;
    let rendered = false;
    let alive = true;
    // What's coming up (JobTread via /api/reveals): the idle hero names the next reveal and lists them. It starts from
    // the schedule the server drew the page from (left on the hero, functions/live/[[path]].js), so the status line,
    // the buttons and the rows are already what this script draws; else as the build had it (the hero's rows were
    // drawn from the same), so a child's page opens with that child's form, not every reveal's until the schedule comes
    const drawnFrom = scheduleOnPage(hero);
    let upcoming: UpcomingReveal[] = drawnFrom?.upcoming ?? upcomingAtBuild();
    let upcomingLoaded = !!drawnFrom;
    // A child's own page once their broadcast isn't the current one: their own last reveal, in the Theater, for good
    // (Peter, Nov 18 2026: "can it be there forever as dylans?"; functions/live/_past-reveal.js). The server leaves it on
    // the hero (data-past); a page open through the child's replay window keeps that replay as it (drawPage)
    let past: LiveState | null = (() => {
      try { const v = JSON.parse(hero.dataset.past || 'null'); return v && v.id && v.player?.kind === 'replay' ? v as LiveState : null; } catch { return null; }
    })();

    const stage = createStage(stageEl, {
      client,
      // The live video still playing the broadcast's last seconds, or "That's the reveal!" up: the page draws itself again
      // (decide keeps it live meanwhile, and keeps the video's place for the note)
      onEnd: () => { if (rendered) render(last, lastMeta); },
      // "That's the reveal!" coming up as the live video plays its last frame: the page changes shape with it (the rail
      // gives way to the design beside the note, the name centred), so it glides there (morph)
      reshape: (end) => { if (rendered) morph(end); else end(); },
      // The hero lays itself out around the video's real shape
      onShape: (orientation, party) => { hero.dataset.orientation = orientation; setAttr(hero, 'data-party', party); },
      // With the video's controls in its rail, "Live" and the number watching are the page's to say: after "Live now"
      // on a computer, beside the kid's name on a phone (LiveStage)
      onAir: (on, n) => {
        const many = n != null ? n.toLocaleString() : '';
        const w = q<HTMLElement>('watching');
        if (w) { w.textContent = many ? `${many} watching` : ''; w.hidden = !(on && many); }
        // ("Live" by the kid's name says the reveal is on, from the server's first paint: the video's own state, such as
        // connecting, shows on the video. null: no live watch party)
        const pill = q<HTMLElement>('onair');
        if (pill) pill.hidden = on === null;
        const pn = q<HTMLElement>('onair-n');
        if (pn) pn.textContent = many ? `·\u00a0${many}` : '';
      },
    });
    // The Theater layout's columns are as tall as the video's stage: measured, for when it's shorter than the screen
    // allows (a window too narrow for the video's full height)
    // (its layout height, not what's on screen: the frame's entrance zooms it in a touch, and a measure taken then was short)
    // (set a frame later, out of the observer's own pass: columns laid out again inside it is a loop browsers warn about)
    let stageFrame = 0;
    const stageSize = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(() => {
      cancelAnimationFrame(stageFrame);
      stageFrame = requestAnimationFrame(() => {
        const h = stageEl.offsetHeight;
        if (h > 0) hero.style.setProperty('--stage-h', `${h}px`); else hero.style.removeProperty('--stage-h');
      });
    }) : null;
    stageSize?.observe(stageEl);

    const panel = document.querySelector<HTMLElement>('[data-msgs="panel"]');
    const heroSlot = hero.querySelector<HTMLElement>('[data-slot="hero"]');
    const section = document.querySelector<HTMLElement>('[data-live-msgs]');
    const sectionSlot = section?.querySelector<HTMLElement>('[data-slot="section"]');
    const messages = panel && heroSlot && section && sectionSlot
      ? createMessages({ client, panel, heroSlot, section, sectionSlot, cta: q('cta-messages') })
      : null;

    // ── The room's design, from the confirmed reveal on (it asks for whichever kid render() is showing) ──
    const designEl = document.querySelector<HTMLElement>('[data-live-design]');
    const design = designEl ? createLiveDesign(designEl, {
      hero,
      rail: hero.querySelector<HTMLElement>('[data-design-rail]'),
      frame: hero.querySelector<HTMLElement>('.hero-frame'),
      stage,
      room: hero.querySelector<HTMLElement>('[data-live-room]'),
    }) : null;

    // ── Giving without leaving the reveal ───────────────────────────
    const giveEl = document.querySelector<HTMLElement>('[data-give]');
    const give = giveEl ? createGive(giveEl, { client, stage }) : null;
    const giveFrom = (where: string) => (e: Event) => {
      // During the watch party the form opens beside the video; otherwise the link goes to /donate/
      if (!give || !stage.party) { client.beacon('click_donate', { where }); return; }
      e.preventDefault();
      give.open(where);
    };
    q('cta-donate')?.addEventListener('click', giveFrom('hero'));
    bq('cta-donate-side')?.addEventListener('click', giveFrom('side'));

    // ── Two hero buttons at most (HERO_CTAS) ────────────────────────
    // Each button still says on its own whether it applies (hidden); this picks the first two that do for the moment
    // and holds the rest back with data-capped. The message box shows or hides its button on its own schedule, so a
    // change to any button's hidden re-picks.
    const ctaBox = hero.querySelector<HTMLElement>('.hero-ctas');
    function capCtas() {
      if (!ctaBox) return;
      const all = [...ctaBox.querySelectorAll<HTMLElement>('[data-live^="cta-"]')];
      const byKey = (k: string) => all.find((el) => el.dataset.live === k);
      const picked = ctaPicks(display, (k) => { const el = byKey(k); return !!el && !el.hidden; }).map(byKey) as HTMLElement[];
      for (const el of all) {
        const at = picked.indexOf(el);
        el.toggleAttribute('data-capped', at < 0);
        el.style.order = at < 0 ? '' : String(at);
      }
    }
    const ctaWatch = ctaBox ? new MutationObserver(capCtas) : null;
    ctaWatch?.observe(ctaBox!, { subtree: true, attributes: true, attributeFilter: ['hidden'] });

    // ── /live/ follows the current kid ──────────────────────────────
    function setTitle(kidName: string | null, view: string) {
      const h1 = q<HTMLElement>('title');
      if (!h1) return;
      const [before, mid, after] = kidName ? [`${kidName}'s `, 'room reveal', '']
        : view === 'live' ? ["Today's ", 'room reveal', '']
        : view === 'replay' ? ['Watch the ', 'reveal', '']
        : ['Watch the ', 'reveal', ' live'];
      if (h1.textContent === `${before}${mid}${after}`) return;
      const em = document.createElement('em');
      em.textContent = mid;
      h1.textContent = '';
      h1.append(before, em, after);
    }
    function setPhoto(src: string) {
      const img = q<HTMLImageElement>('photo');
      if (!img || img.getAttribute('src') === src) return;
      img.removeAttribute('srcset');
      img.src = src;
    }
    // The story in its sentences, as the page is built with them (leadSentences)
    function setLead(el: HTMLElement, text: string) {
      el.replaceChildren(...leadSentences(text).flatMap((t, i) => {
        const span = document.createElement('span');
        span.className = 'lead-s';
        span.textContent = t;
        return i ? [' ', span] : [span];
      }));
    }
    function follow(s: LiveState, view: string) {
      if (pageKid) return;
      const want = view !== 'idle' && s.kidSlug ? s.kidSlug : '';
      if (want !== shownKid) {
        shownKid = want;
        const lead = q<HTMLElement>('lead');
        // (what the room is, under the name in the Theater: only for the child the server drew it for)
        const room = q<HTMLElement>('room');
        if (room) room.hidden = !want || room.dataset.kid !== want || !room.textContent?.trim();
        if (want) {
          if (lead) setLead(lead, s.message || `Watch ${s.kidName ? `${s.kidName}'s` : 'the'} room reveal live, right here.`);
          if (s.image) setPhoto(cfRaw(s.image, 'w=640,h=800,fit=cover,gravity=face,q=82'));
        } else {
          if (lead) setLead(lead, hero.dataset.genericLead || '');
          if (hero.dataset.genericPhoto) setPhoto(hero.dataset.genericPhoto);
        }
      }
      setTitle(want ? s.kidName || null : null, view);
    }

    // Whatever a redraw moves, the field someone is typing in stays where it is on screen; and coming back to the page,
    // its first real drawing puts back what the visitor was looking at. The watch party starting or ending with the
    // page open changes its shape: that drawing morphs (below)
    function render(state: LiveState | null, meta: { reminders: ReminderOptions | null }) {
      const draw = () => {
        const was = display;
        holdPlace(() => drawPage(state, meta));
        restoreSpot();
        // (a change seen with the page open, not its first drawing: coming back to a page puts back where they were)
        if (was !== 'loading' && was !== 'live' && display === 'live') toTheReveal();
      };
      if (morphDraw) { morphDraw = draw; return; }
      // (and when this drawing brings up "That's the reveal!", which changes the stage's shape: see reshape above)
      const next = rendered ? decide(state) : null;
      if (next && (next.party !== hero.hasAttribute('data-party') || (next.party && !stage.ended && stage.endsWith(next.view as 'idle' | 'upcoming' | 'live' | 'replay')))) morph(draw); else draw();
    }

    // ── The reveal starts with the page open: everyone is brought up to the video ──
    // Peter, Nov 17 2026 test: "it seemed to start the video, then it went away and showed the before and plans".
    // Someone further down the page (reading the design, the messages) stayed where they were, the reveal played only in
    // the small player in the corner, and one tap on its × put it away. Going live now brings the page up to the video,
    // unless they're typing, giving, in the menu or full screen (where the corner player still shows it)
    function toTheReveal() {
      const go = () => {
        if (!alive || display !== 'live') return;
        if (typingIn(document.activeElement) || give?.isOpen || document.documentElement.classList.contains('menu-open') || document.fullscreenElement) return;
        // Already in full view: nothing moves
        const top = hero.querySelector<HTMLElement>('[data-stage]') || hero;
        const r = top.getBoundingClientRect();
        if (r.top >= headerLine() - 1 && r.bottom <= innerHeight) return;
        scrollTo({ top: 0, behavior: (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth') as ScrollBehavior });
      };
      // (after the morph, which only plays with the frame in view: it would carry a scroll along with its pictures)
      if (morphing) morphing.finished.catch(() => {}).finally(() => requestAnimationFrame(go)); else requestAnimationFrame(go);
    }

    // ── The page changes shape with it open ──
    // An hour before, "Coming up" becomes the watch party; after it, the party ends. Rather than the page jumping, the
    // frame glides from where it was to where it goes and the rest crossfades (LivePage's ::view-transition rules). Not
    // for the first drawing (the server drew the page in its shape), with less motion asked for, behind another tab,
    // full screen, or with the frame off screen or its picture docked in the corner. While it plays every tap lands on
    // <html> (Chrome; the board page found it): a tap ends it and goes where it was aimed
    let morphing: ViewTransition | null = null;
    // The drawing the morph is about to make: a state that comes before it does is drawn in its place
    let morphDraw: (() => void) | null = null;
    let tapAt: { x: number; y: number } | null = null;
    const MORPH_HIT = 'a, button, input, select, textarea, label, summary, [role="button"]';
    const onMorphTap = (e: PointerEvent) => {
      if (!morphing || e.target !== document.documentElement) return;
      morphing.skipTransition();
      tapAt = { x: e.clientX, y: e.clientY };
    };
    const onMorphClick = (e: MouseEvent) => {
      const at = tapAt;
      tapAt = null;
