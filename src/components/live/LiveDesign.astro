---
/**
 * LiveDesign.astro — "The design" on a reveal's live page
 * =======================================================
 * The room as it is and the plan the designers drew (the design boards wait
 * for the kid page, after the reveal), on the live page from the confirmed
 * reveal on, through it and after
 * (Peter, Nov 9 2026: "it should remain on the page during the reveal too").
 * It sits under the hero, never on the video. Empty and hidden in the built
 * page: src/utils/live-design.ts fills it once /api/reveal-design says it's
 * open, so nothing of the design is in the page before then.
 *
 * Any picture opens large in the viewer (a native <dialog>): drawings need
 * room to be read. Arrows, swipe and Escape work there. During the watch
 * party it is not modal, so the reveal stays in sight: on a laptop it opens
 * beside the video, over the messages (ldv--side, as the give form does);
 * on a phone it fills the screen with the video held small in its top left
 * corner (ldv--pinned: the bar leaves that corner, --ldp-*, and LiveStage
 * pins the video there). The design strip beside the video is
 * LiveDesignRail.astro; live-design.ts drives both.
 */
---

<section class="live-design" data-live-design aria-labelledby="ldz-title" hidden>
  <div class="container">
    <div class="ldz-head">
      <p class="section-label section-label--yellow">The design</p>
      <h2 id="ldz-title" class="ldz-title"><span data-ldz="name">The</span> room, <em>from plan to reveal</em></h2>
      <p class="ldz-lead" data-ldz="lead">How the room looks today and the plan the designers drew. Watch the reveal to see it finished.</p>
    </div>
    <div class="ldz-parts" data-ldz="parts"></div>
  </div>
</section>

<dialog class="ldv" data-ldz-viewer aria-labelledby="ldv-caption">
  <div class="ldv__bar">
    <p class="ldv__caption" id="ldv-caption"><span class="ldv__kicker" data-ldv="kicker"></span><span data-ldv="caption"></span></p>
    <!-- The room, the plan, the look: one tap to each (the one showing says where in it you are); a single part: the count -->
    <div class="ldv__parts" data-ldv="parts" aria-label="Parts of the design"></div>
    <span class="ldv__count" data-ldv="count" aria-live="polite"></span>
    <form method="dialog"><button class="ldv__btn" type="submit" aria-label="Close" data-ldv="close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button></form>
  </div>
  <!-- The pictures, side by side in a strip that moves with a finger (design-viewer.ts) -->
  <div class="ldv__stage" data-ldv="stage"></div>
  <div class="ldv__nav">
    <button class="ldv__btn" type="button" data-ldv="prev" aria-label="Previous picture">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <!-- A whole plan sheet: from its drawing to the whole sheet and back (live-design.ts) -->
    <button class="ldv__btn ldv__zoom" type="button" data-ldv="zoom" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <!-- (its two words stacked in one place, the longer one unseen: the button is that wide either way, never moving) -->
      <span class="ldv__zoom-words"><span data-ldv="zoom-text">Zoom in</span><span class="ldv__zoom-alt" aria-hidden="true">Whole sheet</span><span class="ldv__zoom-alt" aria-hidden="true">Zoom out</span></span>
    </button>
    <button class="ldv__btn" type="button" data-ldv="next" aria-label="Next picture">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</dialog>

<!-- Global: the cards are drawn by live-design.ts, so they never carry this component's scope. Every class is ldz-/ldv- -->
<style is:global>
  .live-design { background: #fff; border-top: 1px solid var(--c-border); padding: clamp(56px, 7vw, 96px) 0; scroll-margin-top: 80px; }
  .live-design[hidden] { display: none; }
  .ldz-head { max-width: 720px; margin-bottom: clamp(32px, 4vw, 48px); }
  .ldz-title { font-size: clamp(1.9rem, 3.4vw, 2.75rem); letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 14px; }
  /* The site's yellow marker, as a flat bar behind the words */
  .ldz-title em { position: relative; z-index: 0; font-style: italic; font-weight: 400; white-space: nowrap; padding: 0 0.05em; }
  .ldz-title em::after { content: ''; position: absolute; z-index: -1; left: 0; right: 0; bottom: 0.06em; height: 0.42em; background: rgba(255, 218, 36, 0.42); }
  .ldz-lead { color: var(--c-text-muted); line-height: 1.7; margin: 0; }

  .ldz-parts { display: grid; gap: clamp(40px, 5vw, 64px); }
  .ldz-part__head { display: flex; align-items: baseline; gap: 14px; margin: 0 0 18px; }
  .ldz-part__title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 700; letter-spacing: -0.015em; margin: 0; }
  .ldz-part__note { color: var(--c-text-muted); font-size: 15px; margin: 0; }

  .ldz-grid { display: grid; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .ldz-grid--photos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ldz-grid--photos[data-n='1'] { grid-template-columns: minmax(0, 1fr); max-width: 880px; }
  .ldz-grid--photos[data-n='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ldz-grid--photos[data-n='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ldz-grid--plans { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .ldz-grid--boards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .ldz-grid--one { grid-template-columns: minmax(0, 1fr); max-width: 880px; }

  .ldz-item {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in;
    border-radius: 18px; overflow: hidden; text-align: left; color: inherit; font: inherit;
  }
  .ldz-item:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 3px; box-shadow: 0 0 0 6px var(--c-dark); }
  /* The picture's own box: it has its shape before the picture arrives (set from a tiny copy), so nothing jumps */
  .ldz-pic { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; }
  .ldz-pic img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .ldz-pic img:not([src]) { visibility: hidden; }
  .ldz-item:hover .ldz-pic img { transform: scale(1.025); }
  .ldz-grid--photos .ldz-item { background: var(--c-cream); }
  .ldz-grid--photos .ldz-pic { aspect-ratio: 4 / 3; }
  .ldz-grid--photos .ldz-pic img { object-fit: cover; }
  /* Drawings and boards on paper: whole, never cropped by the card */
  .ldz-paper { background: #fff; border: 1px solid var(--c-border); box-shadow: 0 18px 40px rgba(30, 31, 37, 0.07); padding: 60px clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px); }
  .ldz-boards .ldz-paper { padding-top: clamp(14px, 2vw, 24px); }
  /* A whole plan sheet is its own paper (its border and title block): edge to edge in the card, its badge in the top
     corner the sheet leaves free (its legend is top left) */
  .ldz-paper.ldz-sheet { padding: 0; }
  .ldz-sheet .ldz-badge { left: auto; right: 12px; }
  /* What a picture is, on it: BEFORE on the room's photos, EXISTING and PROPOSED on the plans. Solid and ringed in white
     so it reads on any photo; the new plan's is the yellow one (the strip's look) */
  .ldz-badge {
    position: absolute; top: 12px; left: 12px; z-index: 1; padding: 7px 12px 6px; border-radius: 8px;
    background: var(--c-dark); color: #fff; font-size: 13px; font-weight: 800; line-height: 1.1; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92), 0 6px 18px rgba(0, 0, 0, 0.2);
  }
  .ldz-badge--proposed { background: var(--c-yellow); color: var(--c-dark); }
  /* A plan's or a board's caption, under it */
  .ldz-cap { margin: 12px 0 0; color: var(--c-text); font-size: 15px; font-weight: 600; line-height: 1.35; }

  /* ── The plan before and after, on one picture (compareHtml, live-design-html.ts; plan-compare.ts lines the two up,
     compare-slider.ts moves the line). The same in the section, the room beside the video and the viewer ── */
  .pcmp {
    --ba-pos: 50%; position: relative; display: block; width: 100%; aspect-ratio: 1 / var(--pcmp-r, 1); overflow: hidden;
    background: #fff; cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  .pcmp__pics { position: absolute; inset: 0; }
  .pcmp__img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity 0.35s ease; -webkit-user-drag: none; pointer-events: none; }
  .pcmp[data-state='ready'] .pcmp__img { opacity: 1; }
  /* Today's plan on the left of the line, the new one on the right */
  .pcmp__img--before { clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0); }
  .pcmp__line {
    position: absolute; z-index: 2; top: 0; bottom: 0; left: var(--ba-pos); width: 2px; margin-left: -1px; pointer-events: none;
    background: var(--c-dark); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.9); opacity: 0; transition: opacity 0.35s ease;
  }
  .pcmp[data-state='ready'] .pcmp__line { opacity: 1; }
  .pcmp__knob {
    /* (kept inside the picture at either end, where the line goes to the edge: --knob-dx, live-design.ts / design-viewer.ts) */
    position: absolute; top: 50%; left: 50%; translate: var(--knob-dx, 0px) 0; display: grid; place-items: center; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%;
    background: var(--c-yellow); color: var(--c-dark); box-shadow: 0 0 0 2px #fff, 0 8px 22px rgba(30, 31, 37, 0.26);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pcmp:hover .pcmp__knob { transform: scale(1.07); }
  .pcmp.is-dragging .pcmp__knob { transform: scale(0.92); transition-duration: 0.1s; }
  /* Which is which, on the picture: the same badges as the sheets (EXISTING dark, PROPOSED yellow); each steps aside
     as the line comes to its side */
  .pcmp__tag {
    position: absolute; z-index: 3; top: 12px; padding: 7px 12px 6px; border-radius: 8px; pointer-events: none;
    font-size: 12.5px; font-weight: 800; line-height: 1.1; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92), 0 6px 18px rgba(0, 0, 0, 0.16); transition: opacity 0.25s ease;
  }
  .pcmp__tag--before { left: 12px; background: var(--c-dark); color: #fff; }
  .pcmp__tag--after { right: 12px; background: var(--c-yellow); color: var(--c-dark); }
  .pcmp__tag[data-fade] { opacity: 0; }
  /* The keyboard's way in (Tab, then the arrows): unseen, its focus shown on the knob */
  .pcmp__range { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; opacity: 0; }
  .pcmp__range:focus-visible ~ .pcmp__line { opacity: 1; }
  .pcmp__range:focus-visible ~ .pcmp__line .pcmp__knob { outline: 3px solid var(--c-dark); outline-offset: 3px; }
  .pcmp__enlarge {
    position: absolute; z-index: 3; right: 12px; bottom: 12px; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid var(--c-border); background: rgba(255, 255, 255, 0.96); color: var(--c-dark); cursor: zoom-in;
    box-shadow: 0 6px 18px rgba(30, 31, 37, 0.12); transition: transform 160ms ease, border-color 160ms ease;
  }
  .pcmp__enlarge:hover { transform: scale(1.06); border-color: var(--c-dark); }
  .pcmp__enlarge:focus-visible { outline: 3px solid var(--c-dark); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .pcmp__img, .pcmp__line, .pcmp__knob, .pcmp__tag { transition: none; } }

  /* In the viewer: it fills its pane, its two pictures zoom and move (design-viewer.ts sets their place), and the line,
     its knob and the badges stay their size, at the place the line marks and on the pictures' visible corners */
  .pcmp.pcmp--viewer { position: absolute; inset: 0; width: auto; aspect-ratio: auto; background: transparent; touch-action: none; }
  .pcmp--viewer .pcmp__pics { inset: auto; left: 0; top: 0; transform-origin: 0 0; background: #fff; }
  .pcmp--viewer .pcmp__line { left: var(--line, 50%); top: var(--pics-t, 0px); bottom: var(--pics-b, 0px); }
  .pcmp--viewer .pcmp__tag--before { left: calc(var(--pics-l, 0px) + 12px); top: calc(var(--pics-t, 0px) + 12px); }
  .pcmp--viewer .pcmp__tag--after { right: calc(var(--pics-r, 0px) + 12px); top: calc(var(--pics-t, 0px) + 12px); }

  /* The section's plan: the compare first, as wide as the plans were, then the designer's two sheets, smaller */
  .ldz-compare { max-width: 880px; }
  /* (never taller than the window leaves under the site's header: the whole plan in sight while its line is dragged) */
  .ldz-compare .pcmp { width: min(100%, calc((100svh - var(--header-height, 80px) - 96px) / var(--pcmp-r, 1))); border-radius: 18px; border: 1px solid var(--c-border); box-shadow: 0 18px 40px rgba(30, 31, 37, 0.07); }
  .ldz-sheets { margin: 28px 0 12px; color: var(--c-text-muted); font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .ldz-grid--sheets { max-width: 880px; gap: 16px; }
  .ldz-grid--sheets .ldz-cap { font-size: 14px; }

  @media (max-width: 768px) {
    .ldz-grid--photos, .ldz-grid--photos[data-n='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .ldz-grid--plans, .ldz-grid--boards { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    /* (beside the compare, the sheets stay two across: they're the record, a tap opens either big) */
    .ldz-grid--plans.ldz-grid--sheets { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .ldz-grid--sheets .ldz-badge { top: 6px; right: 6px; padding: 5px 8px 4px; font-size: 10.5px; }
    .ldz-grid--sheets .ldz-cap { font-size: 13px; margin-top: 8px; }
    .ldz-item, .ldz-compare .pcmp { border-radius: 14px; }
    .pcmp__tag { top: 10px; padding: 6px 10px 5px; font-size: 11px; }
    .pcmp__tag--before { left: 10px; }
    .pcmp__tag--after { right: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ldz-item img { transition: none; }
    .ldz-item:hover .ldz-pic img { transform: none; }
  }

  /* ── Viewer ── */
  .ldv {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #16171b; color: #fff; overflow: hidden; overscroll-behavior: contain;
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .ldv:not([open]) { display: none; }
  .ldv::backdrop { background: rgba(22, 23, 27, 0.6); }

  /* Where the video sits, small, while the viewer covers a phone (LiveStage's 'design' pin reads these) */
  :root { --ldp-top: calc(max(10px, env(safe-area-inset-top, 0px)) + 30px); --ldp-h: 148px; --ldp-hw: 88px; --ldp-left: max(12px, env(safe-area-inset-left, 0px)); }

  /* Beside the video on a laptop: down the left, over the messages; the video and the strip stay as they are */
  .ldv.ldv--side {
    /* (over the story column exactly: as tall as the video beside it, live-design.ts fitSide) */
    position: fixed; z-index: 1200; inset: var(--ldv-top, calc(var(--header-height) + 12px)) auto auto 12px;
    width: var(--ldv-w, 640px); height: var(--ldv-h, calc(100dvh - var(--header-height) - 24px)); border-radius: 20px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32), 0 8px 24px rgba(0, 0, 0, 0.14);
    animation: ldv-side 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes ldv-side { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
  .ldv--side .ldv__bar { padding-top: 16px; }

  /* A phone: the whole screen, the video small in the top left corner and the caption beside it */
  .ldv.ldv--pinned { position: fixed; z-index: 1200; inset: 0; animation: ldv-pinned 0.24s ease-out; }
  @keyframes ldv-pinned { from { opacity: 0; } to { opacity: 1; } }
  .ldv--pinned .ldv__bar {
    --pin-w: calc(var(--ldp-h) * 0.5625);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; column-gap: 12px; row-gap: 8px;
    min-height: calc(var(--ldp-top) + var(--ldp-h) + 12px); padding: var(--ldp-top) 12px 0 calc(var(--ldp-left) + var(--pin-w) + 16px);
  }
  .ldv--pinned.ldv--wide .ldv__bar { --pin-w: calc(var(--ldp-hw) * 1.7778); min-height: calc(var(--ldp-top) + var(--ldp-hw) + 12px); }
  .ldv--pinned .ldv__caption { display: block; grid-column: 1; grid-row: 1; font-size: 15.5px; -webkit-line-clamp: unset; }
  .ldv--pinned .ldv__bar > .ldv__parts { grid-area: auto; grid-column: 1 / -1; grid-row: 2; }
  .ldv--pinned .ldv__bar > .ldv__count { grid-area: auto; grid-column: 1; grid-row: 3; justify-self: start; font-size: 13.5px; }
  .ldv--pinned .ldv__part { height: 30px; padding: 0 10px; font-size: 13px; }
  .ldv--pinned .ldv__bar > form { grid-column: 2; grid-row: 1; margin-top: -4px; }
  @media (prefers-reduced-motion: reduce) { .ldv.ldv--side, .ldv.ldv--pinned { animation: none; } }
  /* What it is and the close button on top; the parts and where in its part this one is under them */
  .ldv__bar {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'cap close' 'parts count'; align-items: center;
    column-gap: 16px; row-gap: 10px; padding: max(14px, env(safe-area-inset-top)) clamp(14px, 3vw, 28px) 10px;
  }
  .ldv__bar > .ldv__caption { grid-area: cap; }
  .ldv__bar > form { grid-area: close; }
  .ldv__bar > .ldv__parts { grid-area: parts; }
  .ldv__bar > .ldv__count { grid-area: count; justify-self: end; }
  /* (always two lines tall: a one-line caption and a two-line one leave the pictures under them the same room, so nothing
     jumps between them) */
  .ldv__caption { min-width: 0; min-height: 2.7em; margin: 0; font-size: 16px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .ldv__kicker { margin-right: 10px; color: var(--c-yellow); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  /* A picture's badge leads its caption, as on the picture: white for the room before and the existing plan, yellow for the proposed */
  .ldv__kicker:is([data-kind='before'], [data-kind='as-built'], [data-kind='proposed']) {
    display: inline-block; padding: 5px 9px 4px; border-radius: 6px; background: #fff; color: #16171b;
    font-weight: 800; letter-spacing: 0.12em; vertical-align: 1px;
  }
  .ldv__kicker[data-kind='proposed'] { background: var(--c-yellow); }
  /* On a phone, beside the small video: the badge on its own line above the caption */
  .ldv.ldv--pinned .ldv__kicker { display: table; margin: 0 0 8px; }
  .ldv__count { color: rgba(255, 255, 255, 0.7); font-size: 14px; font-variant-numeric: tabular-nums; }
  .ldv__count:empty { display: none; }
  /* The parts: pills, the one showing yellow with where in it you are ("The room · 2 of 5"). One tap jumps to a part */
  .ldv__parts { display: flex; flex-wrap: wrap; gap: 6px; }
  .ldv__parts:empty { display: none; }
  .ldv__part {
    height: 32px; padding: 0 12px; border-radius: 100px; border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.06);
    color: #fff; font: inherit; font-size: 13.5px; font-weight: 700; white-space: nowrap; cursor: pointer; font-variant-numeric: tabular-nums;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .ldv__part:hover { background: rgba(255, 255, 255, 0.14); }
  .ldv__part[aria-current='true'] { background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-dark); }
  .ldv__part:focus-visible { outline: 3px solid var(--c-yellow); outline-offset: 2px; }
  .ldv__part-at { font-weight: 600; opacity: 0.75; margin-left: 6px; }
  /* The pictures always fit the space between the bar and the arrows, whatever their shape and the screen's. The page
     never pinches or scrolls under a finger here: the pictures answer it (design-viewer.ts) */
  .ldv__stage { position: relative; min-height: 0; margin: 8px clamp(8px, 3vw, 28px); touch-action: none; overflow: hidden; user-select: none; -webkit-user-select: none; }
  .ldg-track { position: absolute; inset: 0; will-change: transform; }
  .ldg-pane { position: absolute; top: 0; bottom: 0; overflow: hidden; }
  .ldg-fly { position: absolute; inset: 0; transform-origin: 50% 50%; }
  .ldg-zoom { position: absolute; left: 0; top: 0; transform-origin: 0 0; cursor: zoom-in; }
  .ldv__stage[data-zoomed] .ldg-zoom { cursor: grab; }
  .ldv__stage[data-zoomed] .ldg-zoom:active { cursor: grabbing; }
  .ldg-img { display: block; width: 100%; height: 100%; object-fit: contain; -webkit-user-drag: none; -webkit-touch-callout: none; }
  /* A drawing or a board on its white paper (the picture's own box: a zoomed one shows paper to its edges) */
  .ldg-pane:is([data-kind='sheet'], [data-kind='paper']) .ldg-zoom { background: #fff; }
  .ldg-cmp { position: absolute; inset: 0; }
  .ldv__nav { display: flex; justify-content: center; gap: 16px; padding: 10px 0 max(18px, env(safe-area-inset-bottom)); }
  .ldv__btn {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.08); color: #fff; cursor: pointer;
  }
