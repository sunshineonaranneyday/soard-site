---
/**
 * LiveStage.astro — the frame on the live page: photo, then the video
 * ====================================================================
 * Before the watch party it is the hero's portrait photo with its badge
 * (countdown, "Live" for a Facebook-only broadcast, "Processing").
 *
 * During the watch party (data-party: live, replay) it is the
 * video, as big as the screen allows, with nothing drawn on the picture. Live
 * and upright (data-rail, the Theater layout, Peter, Nov 17 2026) its controls
 * are a rail beside it: Tap for sound (then Sound) and Full screen at the top,
 * the heart at the foot, sending hearts up the rail. Otherwise one simple bar
 * under it:
 *
 *   ┌──────────────┐
 *   │              │
 *   │    video     │
 *   │              │
 *   └──────────────┘
 *   captions line                        (replay, when switched on)
 *   ● LIVE · 34 watching    [Tap for sound]   then   [sound] [♥] [full screen]
 *   or  [▶] seek bar with the reveal's ★ (tap it: the reveal), times under it  [CC] [full screen]   (replay)
 *
 * The only things ever shown over the frame are for when there is no
 * picture: "The camera is getting ready", "Reconnecting", "Tap to watch".
 *
 * Sizing: the page sets --fh, the height the whole stage may take; the
 * stage fits the video and bar inside it at the picture's real shape (--ar,
 * width / height). Behaviour lives in src/utils/live-stage.ts.
 *
 * Under it all, the build's partners scroll by (the page's "under" slot,
 * LivePartners.astro; data-partners when there are any): under the photo
 * before the reveal, under the video's bar during it, and their height comes
 * out of the picture's so they stay on screen with it. Not in full screen,
 * nor on a phone held sideways, where the picture needs the screen's height.
 */
import { cfRaw, cfSrcset, cfLqip } from '../../utils/cf-image';
import { morphPath } from '../../utils/play-morph';

// Sunny & Ranney, SOARD's store (its round logo: Gracie flying with her lamp, on the store's cyan)
const SHOP = 'https://sunnyandranney.com/';
const SHOP_LOGO = cfRaw('https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ/partners/sunny-and-ranney/public', 'w=96,h=96,fit=cover,q=85');

interface Props { photo: string; alt: string; partners?: boolean }
const { photo, alt, partners = false } = Astro.props;

const svg = (paths: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const SPEAKER = '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/>';
const ICON = {
  soundOff: svg(`${SPEAKER}<path d="M22 9l-6 6"/><path d="M16 9l6 6"/>`),
  soundOn: svg(`${SPEAKER}<path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/>`),
  full: svg('<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>'),
  fullExit: svg('<path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/>'),
  // Going back through the broadcast so far: to its start, and back to the live moment
  fromStart: svg('<path d="M6 5v14"/><path d="M19 6.5v11a1 1 0 0 1-1.55.83L9.5 13.03a1.25 1.25 0 0 1 0-2.06l7.95-5.3A1 1 0 0 1 19 6.5Z"/>'),
  toLive: svg('<path d="M18 5v14"/><path d="M5 6.5v11a1 1 0 0 0 1.55.83l7.95-5.3a1.25 1.25 0 0 0 0-2.06L6.55 5.67A1 1 0 0 0 5 6.5Z"/>'),
  heart: svg('<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>'),
  play: svg('<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z" fill="currentColor"/>'),
  close: svg('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'),
  // Share (as the page's own Share button), and Fund the next room: a gift, not a heart (the heart is love sent)
  share: svg('<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/>'),
  fund: svg('<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>'),
  eye: svg('<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>'),
  spark: svg('<path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/>'),
};
---

<div class="stage" data-stage data-mode="loading" data-orientation="portrait" data-partners={partners ? '' : undefined} tabindex="-1">
  <div class="stage__screen">
    <div class="stage__accent" aria-hidden="true"></div>
    <div class="stage__picture" data-s="picture" data-live="frame" style={`background-image:url(${cfLqip(photo)})`}>
      <div class="stage__clip">
        <img
          class="stage__photo lqip-img"
          src={cfRaw(photo, 'w=640,h=800,fit=cover,gravity=face,q=82')}
          srcset={cfSrcset(photo, [400, 640, 800, 1024], { fit: 'cover', gravity: 'face', aspectRatio: 1.25 })}
          sizes="(max-width: 960px) 90vw, 40vw"
          width="640" height="800"
          alt={alt}
          loading="eager" fetchpriority="high" decoding="async"
          data-live="photo"
        />
        <div class="stage__player" data-s="player" hidden></div>
        <div class="stage__note" data-s="note" role="status" hidden>
          <p class="stage__note-title" data-s="note-title"></p>
          <p class="stage__note-text" data-s="note-text"></p>
        </div>
        <!-- The reveal over: once the live video has played its last frame (live-stage.ts), over the soft photo like the
             notes above, never over the video. The replay starts only when asked for -->
        <div class="stage__end" data-s="end" role="status" hidden>
          <p class="stage__end-title">That's the reveal!</p>
          <p class="stage__end-text" data-s="end-text">Thank you for watching.</p>
          <button class="stage__end-btn" type="button" data-s="end-replay" aria-label="Watch the replay" hidden><Fragment set:html={ICON.play} /><span class="stage__end-long">Watch the replay</span><span class="stage__end-short">Replay</span></button>
          <p class="stage__end-wait" data-s="end-wait">The replay will be here in a few minutes.<span class="stage__end-line" aria-hidden="true"><span class="stage__end-fill" data-s="end-fill"></span></span></p>
        </div>
        <button class="stage__tap" type="button" data-s="tap" hidden>
          <span class="stage__tap-icon"><Fragment set:html={ICON.play} /></span>
          <span class="stage__tap-word">Tap to watch</span>
        </button>
        <p class="stage__badge" data-s="badge" hidden><span class="stage__badge-dot" aria-hidden="true"></span><span data-s="badge-text"></span></p>
      </div>
      <div class="stage__dockbar" data-s="dockbar" hidden>
        <span class="stage__dock-label"><span class="dot" aria-hidden="true"></span><span data-s="dock-label">Live</span></span>
        <button class="stage__undock" type="button" data-s="undock" aria-label="Close the mini player"><Fragment set:html={ICON.close} /></button>
      </div>
    </div>
  </div>

  <p class="stage__cc" data-s="cc" aria-hidden="true" hidden><span data-s="cc-text"></span></p>

  <!-- Before the reveal, in the Theater: when it goes live, under the photo in the video's place, never on it (Peter, Nov
       20 2026: "why not go ahead and show the theater mode"; live-stage.ts StageView.waiting) -->
  <p class="stage__when" data-s="when" hidden><span class="stage__when-k">Watch it live, right here</span><span class="stage__when-t"><span data-s="when-when"></span> <span class="stage__when-in" data-s="when-sub"></span></span></p>

  <!-- During the reveal on a computer: "Live" and the number watching, under the picture, as a phone's bar has them
       (Peter, Nov 21 2026: "why doesnt desktop show live viewer count like mobile and ipad?", then "yes, put it under
       the video"). The rail beside the picture has no room for them; they were the small line above the kid's name -->
  <p class="stage__live" data-s="liveline" hidden><span class="stage__live-on"><span class="bar__dot" aria-hidden="true"></span>Live</span><span class="stage__live-n" data-s="liveline-count" hidden><Fragment set:html={ICON.eye} /><span><span data-s="liveline-num"></span> watching</span></span></p>

  <div class="stage__bar" data-s="bar" hidden>
    <div class="bar__live" data-s="livebar">
      <span class="bar__status"><span class="bar__dot" aria-hidden="true"></span><span data-s="status">Connecting</span></span>
      <span class="bar__count" data-s="count" hidden><span class="bar__count-n"><Fragment set:html={ICON.eye} /><span data-s="count-num"></span></span><span class="bar__count-word" data-s="count-word"></span></span>
      <span class="bar__end">
        <button class="bar__sound" type="button" data-s="sound" title="Turn the sound on" hidden><span class="bar__ico"><Fragment set:html={ICON.soundOff} /></span><span class="bar__txt">Tap for sound</span></button>
        <button class="bar__btn" type="button" data-s="mute" aria-label="Sound" aria-pressed="true" title="Sound (M)" hidden>
          <span class="bar__ico"><span class="bar__on"><Fragment set:html={ICON.soundOn} /></span><span class="bar__off"><Fragment set:html={ICON.soundOff} /></span></span>
          <span class="bar__lbl" aria-hidden="true">Sound</span>
        </button>
        <!-- Going back through the broadcast so far (Cloudflare keeps it as it goes): from its start, then back to the
             live moment, with how far behind you are -->
        <button class="bar__btn bar__dvr" type="button" data-s="from-start" aria-label="Watch from the start" title="From the start" hidden><span class="bar__ico"><Fragment set:html={ICON.fromStart} /></span><span class="bar__lbl" aria-hidden="true">Rewind</span></button>
        <button class="bar__btn bar__dvr bar__tolive" type="button" data-s="to-live" aria-label="Back to live" title="Back to live" hidden><span class="bar__ico"><Fragment set:html={ICON.toLive} /></span><span class="bar__lbl" aria-hidden="true">Live</span><span class="bar__behind" data-s="behind" aria-hidden="true"></span></button>
        <button class="bar__btn bar__full" type="button" data-full aria-label="Full screen" title="Full screen (F)" hidden><span class="bar__ico"><span class="full-in"><Fragment set:html={ICON.full} /></span><span class="full-out"><Fragment set:html={ICON.fullExit} /></span></span><span class="bar__lbl" aria-hidden="true">Full screen</span></button>
        <!-- The room's before photos and plans (live-design.ts opens its viewer; the video stays small in the corner): the
             rail sits where the design's strip did, so it's the way in. Its face is the room's first picture -->
        <button class="bar__btn bar__design" type="button" data-s="design" aria-label="See the room and the plan" title="The room and the plan" hidden><span class="bar__ico"><img data-s="design-face" alt="" decoding="async" /></span><span class="bar__lbl" aria-hidden="true">The room</span></button>
        <!-- Share and Fund the next room, in the Theater's rail on a computer (Peter, Nov 20 2026: "can you move the share
             and fund a room in the rail where play and full screen etc are?"): the head's own buttons, pressed from here
             (LivePage mirrors whether each applies and passes the press on); never in a phone's bar -->
        <button class="bar__btn bar__act bar__act--share" type="button" data-act="share" aria-label="Share" title="Share this reveal" hidden><span class="bar__ico"><Fragment set:html={ICON.share} /></span><span class="bar__lbl" aria-hidden="true" data-act-label>Share</span></button>
        <button class="bar__btn bar__act bar__act--fund" type="button" data-act="fund" aria-label="Fund the next room" title="Fund the next room" hidden><span class="bar__ico"><Fragment set:html={ICON.fund} /></span><span class="bar__lbl" aria-hidden="true">Fund</span></button>
        <!-- Shop Sunny & Ranney, the store whose profits build the rooms (Peter, Nov 20 2026: "in the play rail, add a button
             to shop at https://sunnyandranney.com/, use the logo with gracie holding lamp"): its own round logo, Gracie
             flying with her lamp, under Fund; the store opens in a new tab, the reveal plays on. Shown with Fund (LivePage) -->
        <a class="bar__btn bar__act bar__act--shop" href={SHOP} target="_blank" rel="noopener" data-shop aria-label="Shop Sunny & Ranney (opens the store in a new tab)" title="Shop Sunny & Ranney" hidden><span class="bar__ico"><img src={SHOP_LOGO} alt="" width="46" height="46" decoding="async" loading="lazy" /></span><span class="bar__lbl" aria-hidden="true">Shop</span></a>
        <!-- In the rail beside a portrait picture (data-rail): the hearts everyone sends float up here, beside the picture, never on it -->
        <span class="bar__rise" data-s="rise" aria-hidden="true"></span>
        <button class="bar__btn bar__heart" type="button" data-s="heart" aria-label="Send love to the family" title="Send love" hidden><span class="bar__ico"><Fragment set:html={ICON.heart} /></span></button>
        <!-- (said for a screen reader when love is sent: the hearts are only seen) -->
        <span class="sr-only" data-s="said" role="status"></span>
      </span>
    </div>
    <div class="bar__replay" data-s="replaybar" hidden>
      <!-- One icon that turns from play into pause and back (play-morph.ts), never one blinking out for the other -->
      <button class="bar__play" type="button" data-s="play" aria-label="Play" title="Play or pause (Space)">
        <span class="bar__play-ico"><svg class="bar__morph" viewBox="0 0 24 24" aria-hidden="true"><path data-s="morph" d={morphPath(0)} /></svg></span>
        <!-- (its word, in the rail only: "Play", "Pause" while it plays) -->
        <span class="bar__lbl bar__lbl--play" aria-hidden="true">Play</span><span class="bar__lbl bar__lbl--pause" aria-hidden="true">Pause</span>
      </button>
      <!-- The progress line. A finger or the mouse works it anywhere along it (live-stage.ts): the picture follows the
           finger, the handle grows under it. The slider is there for the keyboard and screen readers; the line, how much
           has loaded, how far it's played and the handle are drawn, so they can glide with the picture -->
      <div class="seek" data-s="seekcell">
        <input class="seek__range" type="range" min="0" max="1000" step="1" value="0" data-s="seek" aria-label="Seek" aria-valuetext="0:00" />
        <span class="seek__line" aria-hidden="true"><span class="seek__loaded"></span><span class="seek__played"></span></span>
        <!-- The reveal's star: the way to the reveal (Peter, Nov 19 2026: "i dont like how much room the jump to reveal
             takes on the screen"). A tap or click on it plays from the reveal (through the line's own handling, so a press
             that moves still drags); the keyboard reaches it as a button. Its time under it, when that fits clear of the
             line's two times (never moving them) -->
        <button class="seek__mark" type="button" data-s="mark" aria-label="Jump to the reveal" hidden><Fragment set:html={ICON.spark} /></button>
        <span class="seek__at" data-s="mark-at" aria-hidden="true" hidden></span>
        <span class="seek__glide" aria-hidden="true"><span class="seek__knob"></span></span>
        <span class="seek__ring" aria-hidden="true"></span>
      </div>
      <span class="bar__time" data-s="time"><span data-s="time-now">0:00</span><span class="bar__total" data-s="time-total"></span></span>
      <button class="bar__btn bar__cc" type="button" data-s="cc-toggle" aria-label="Captions" aria-pressed="false" title="Captions (C)" hidden><span class="bar__cc-ico">CC</span><span class="bar__lbl" aria-hidden="true">Captions</span></button>
      <button class="bar__btn bar__full" type="button" data-full aria-label="Full screen" title="Full screen (F)"><span class="bar__full-ico"><span class="full-in"><Fragment set:html={ICON.full} /></span><span class="full-out"><Fragment set:html={ICON.fullExit} /></span></span><span class="bar__lbl" aria-hidden="true">Full screen</span></button>
      <!-- (Share and Fund the next room, in the replay's rail as in live's) -->
      <button class="bar__btn bar__act bar__act--share" type="button" data-act="share" aria-label="Share" title="Share this reveal" hidden><span class="bar__ico"><Fragment set:html={ICON.share} /></span><span class="bar__lbl" aria-hidden="true" data-act-label>Share</span></button>
      <button class="bar__btn bar__act bar__act--fund" type="button" data-act="fund" aria-label="Fund the next room" title="Fund the next room" hidden><span class="bar__ico"><Fragment set:html={ICON.fund} /></span><span class="bar__lbl" aria-hidden="true">Fund</span></button>
      <a class="bar__btn bar__act bar__act--shop" href={SHOP} target="_blank" rel="noopener" data-shop aria-label="Shop Sunny & Ranney (opens the store in a new tab)" title="Shop Sunny & Ranney" hidden><span class="bar__ico"><img src={SHOP_LOGO} alt="" width="46" height="46" decoding="async" loading="lazy" /></span><span class="bar__lbl" aria-hidden="true">Shop</span></a>
    </div>
  </div>

  <!-- Something that goes with the picture (the page's design strip). The grid places it beside the picture; it comes
       last so the keyboard reaches the video's own controls first -->
  <div class="stage__beside"><slot name="beside" /></div>

  <!-- The build's partners, scrolling under everything (LivePartners.astro) -->
  <div class="stage__under"><slot name="under" /></div>
</div>

<style>
  /* ── Before the watch party: the hero's portrait photo ── */
  .stage { --ar: 0.5625; --gap: 8px; --bar: 52px; --below: calc(var(--bar) + var(--gap) + var(--under, 0px)); position: relative; outline: none; }
  .stage[data-orientation='landscape'] { --ar: 1.7778; }
  .stage__screen { position: relative; }
  .stage__accent {
    position: absolute; bottom: -16px; right: -16px; width: 65%; height: 50%; background: var(--c-yellow);
    border-radius: 24px; z-index: 0; opacity: 0; animation: accentIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
  }
  @keyframes accentIn { to { opacity: 0.35; } }
  .stage__picture {
    position: relative; z-index: 1; aspect-ratio: 4 / 5; border-radius: 24px;
    background-size: cover; background-position: center; background-color: var(--c-dark-deep);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .stage__clip { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; container-type: inline-size; }
  .stage__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* The partners: above the yellow block that peeks out from behind the frame, and clear of it under the photo */
  .stage__under { position: relative; z-index: 1; min-width: 0; }
  .stage:not([data-partners]) .stage__under { display: none; }
  .stage:not([data-party]) .stage__under { margin-top: 36px; }
  .stage__player { position: absolute; inset: 0; transition: opacity 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .stage__player[hidden] { display: none; }
  /* :global: the video and iframes are created at runtime, so they have no Astro scope attribute */
  .stage__player :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  /* (no black of its own: until its first picture, what's behind it shows, the frame's dark and the soft photo) */
  .stage__player :global(video) { width: 100%; height: 100%; display: block; object-fit: contain; background: transparent; }
  .stage[data-pkind='replay'] .stage__player :global(video) { cursor: pointer; }
  /* The frame takes the picture's own shape (--ar, data-exact: live-stage.ts), so the picture fills it, and reaches a pixel
     past each edge, where the frame's rounded clip trims it. iPhone Safari draws a video on whole screen pixels: where the
     frame sat at a fraction of one, a column of the frame's dark showed down one side of the picture (Peter's screenshot,
     Nov 18 2026; measured in iPhone Safari at 402 points wide, fitted inside or filling it exactly alike; the recording's
     own edge is clean) */
  .stage[data-exact] .stage__player { inset: -1px; }
  .stage[data-exact] .stage__player :global(video) { object-fit: cover; }

  .stage__badge {
    position: absolute; left: 16px; bottom: 16px; z-index: 3; margin: 0;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--c-dark-deep); color: var(--c-cream); padding: 10px 16px; border-radius: 100px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.02em; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .stage__badge[hidden] { display: none; }
  /* When it goes live, before the reveal in the Theater (StageView.waiting): under the photo, where the bar goes during
     the reveal (a phone's: the photo with the room's pictures beside it, as after the reveal, LiveDesignRail). On a
     computer the photo is exactly where the live picture will be, the rail's place kept (LivePage), and this sits in the
     timeline's row under it: at the start only the picture changes, and the rail's controls come in beside it */
  .stage__when { display: none; }
  .stage[data-party][data-mode='upcoming'] .stage__when:not([hidden]) {
    grid-area: bar; align-self: center; display: grid; justify-items: center; gap: 2px; min-width: 0; margin: 0;
    padding-top: var(--gap); text-align: center; container-type: inline-size;
  }
  @media (min-width: 1200px) {
    .stage[data-party][data-orientation='portrait'][data-mode='upcoming']:not([data-fullscreen]) .stage__when:not([hidden]) { grid-area: auto; grid-row: 3; grid-column: 2; padding-top: 0; }
  }
  /* (with the rail beside the photo, holding Share and Fund the next room until the reveal: the rail's own rows, the
     picture's and the line under it, where the replay's timeline goes; the server marks the rail from the first paint
     wherever its styles apply, the same screens as live) */
  @media (min-width: 1101px), (min-width: 961px) and (max-height: 1199px), (min-width: 560px) and (min-aspect-ratio: 7/4) and (max-height: 540px) {
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) {
      --below: calc(var(--line, 48px) + var(--under, 0px));
      grid-template-rows: auto var(--line, 48px) auto;
      grid-template-areas: '. screen . bar .' '. . . . .' 'under under under under under';
    }
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .stage__when:not([hidden]) { grid-area: auto; grid-row: 2; grid-column: 2; padding-top: 0; }
    /* (Share and Fund the next room in it on every screen it shows on, the computer Theater's rule below: before the
       reveal they're all it holds, never an empty column) */
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__end > .bar__act:not([hidden]) { display: flex !important; }
    /* (each slot one height, a one-line word or two, so the circles step evenly down the rail) */
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__end > :is(button, a):not(.bar__heart) { min-height: 0; justify-content: flex-start; }
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__act--fund .bar__ico { background: var(--c-yellow-soft); border-color: var(--c-yellow-soft); }
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__act--shop { text-decoration: none; color: var(--c-dark); }
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__act--shop .bar__ico { padding: 0; overflow: hidden; border-color: transparent; background: #3E9EBE; }
    .stage[data-party][data-orientation='portrait'][data-rail][data-mode='upcoming']:not([data-fullscreen]) .bar__act--shop .bar__ico img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; transform: scale(1.1); }
  }
  .stage__when-k {
    display: inline-flex; align-items: center; gap: 7px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--c-text-muted);
  }
  .stage__when-k::before { content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--c-yellow); }
  /* (on the day itself, a ring round the dot, as the watch card's play mark has) */
  .stage[data-today] .stage__when-k::before { box-shadow: 0 0 0 3px rgba(255, 218, 36, 0.35); }
  .stage__when-t { font-family: var(--font-display); font-size: 15.5px; line-height: 1.3; color: var(--c-dark); text-wrap: balance; }
  .stage__when-t > span { white-space: nowrap; }
  .stage__when-in { color: var(--c-text-muted); }
  .stage__when-in::before { content: '· '; }
  .stage__when-in:empty { display: none; }
  /* (a narrow picture, a small phone's: the time alone) */
  @container (max-width: 250px) { .stage__when-k { display: none; } }
  .stage__badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-yellow); }

  /* ── Watch party: the video, with the bar underneath ── */
  .stage[data-party] {
    /* The picture: as big as the height allows at its shape (--pic). Beside it, whatever the page puts there (it says
       how wide with --beside and --beside-gap: the design strip, as tall as the picture). The captions line, the bar
       run under both. The stage is as wide as that, or as wide as its controls need (--controls-min) when
       that's more, never wider than the column: on a phone a portrait picture is sized by the screen's height, so it
       can be narrower than its bar needs, and then the picture and what's beside it keep their size in the middle and
       the bar takes the room (Peter, Nov 11 2026: the video stays full size, no shortcuts) */
    --pic: calc((var(--fh, 640px) - var(--below)) * var(--ar));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--pic)) var(--beside-gap, 0px) var(--beside, 0px) minmax(0, 1fr);
    grid-template-areas: '. screen . beside .' 'cc cc cc cc cc' 'bar bar bar bar bar' 'under under under under under';
    width: min(var(--stage-max, 100%), max(calc(var(--pic) + var(--beside-gap, 0px) + var(--beside, 0px)), var(--controls-min, 0px)));
    margin-inline: auto;
  }
  /* A landscape picture fills the width: what goes with it sits under everything */
  .stage[data-party][data-orientation='landscape'] { grid-template-areas: '. screen . . .' 'cc cc cc cc cc' 'bar bar bar bar bar' 'beside beside beside beside beside' 'under under under under under'; }
  .stage[data-party] .stage__screen { grid-area: screen; }
  .stage[data-party] .stage__beside { grid-area: beside; position: relative; min-width: 0; }
  .stage[data-party] .stage__cc { grid-area: cc; }
  .stage[data-party] .stage__bar { grid-area: bar; container: bar / inline-size; }
  .stage[data-party] .stage__under { grid-area: under; margin-top: var(--gap); }
  /* The partners take their own height out of the picture's, so the picture, its bar and they all fit the screen */
  .stage[data-party][data-partners] { --under: calc(var(--lpb-h) + var(--gap)); }
  /* A replay's bar holds play, the line, captions and full screen: room enough for a line worth dragging */
  .stage[data-party][data-mode='replay'] { --controls-min: 320px; }
  /* Live: "Live", the count and three buttons (or Tap for sound) */
  .stage[data-party][data-mode='live'] { --controls-min: 270px; }
  .stage[data-party][data-cc] { --below: calc(var(--bar) + var(--gap) + 3.4em + var(--gap) + var(--under, 0px)); }
  .stage[data-party] .stage__screen { aspect-ratio: var(--ar); }
  .stage[data-party] .stage__picture { position: absolute; inset: 0; aspect-ratio: auto; border-radius: 20px; }
  /* While the video connects or reconnects, the kid's photo, soft and dim, sits behind the note; the video fades in
     over it as it starts, and the photo fades away under it (a crossfade, never a cut). In the watch party the frame
     behind them is plain dark: the small blurry stand-in photo that waits for the real one before the party isn't
     wanted around a video */
  .stage[data-party] .stage__picture { background-image: none !important; }
  /* (once faded, not drawn at all: a blur under a playing video costs a phone for nothing) */
  .stage[data-party] .stage__photo {
    opacity: 0; visibility: hidden; filter: blur(16px) brightness(0.5); transform: scale(1.12);
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }
  .stage[data-party]:not([data-pstatus]) .stage__photo,
  .stage[data-party][data-pstatus='connecting'] .stage__photo,
  .stage[data-party][data-pstatus='waiting'] .stage__photo,
  .stage[data-party][data-pstatus='reconnecting'] .stage__photo { opacity: 1; visibility: visible; transition: opacity 0.45s ease, visibility 0s; }
  /* Before the reveal, in the Theater (StageView.waiting): the photo itself, sharp, where the video will be (going live,
     the page's morph crossfades it into the soft stand-in behind "The camera is getting ready") */
  .stage[data-party][data-mode='upcoming'] .stage__photo { filter: none; transform: none; }
  .stage[data-pkind='live'][data-pstatus='connecting'] .stage__player,
  .stage[data-pstatus='waiting'] .stage__player,
  .stage[data-pstatus='reconnecting'] .stage__player { opacity: 0; }

  .stage__note {
    position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; text-align: center;
    padding: 24px; color: #fff; pointer-events: none;
  }
  .stage__note[hidden] { display: none; }
  .stage__note:not([hidden]) { animation: noteIn 0.35s ease-out both; }
  @keyframes noteIn { from { opacity: 0; } }
  .stage__note-title { font-family: var(--font-display); font-size: clamp(1.2rem, 7cqi, 1.6rem); line-height: 1.2; margin: 0 0 8px; }
  .stage__note-text { font-size: 14px; line-height: 1.55; margin: 0 auto; max-width: 30ch; color: rgba(255, 255, 255, 0.86); }
  .stage__note-text:empty { display: none; }

  /* The reveal over: the soft photo behind, the words on it, a button for the replay once there is one */
  .stage[data-ended] .stage__photo { opacity: 1; visibility: visible; transition: opacity 0.45s ease, visibility 0s; }
  .stage[data-ended] .stage__player { opacity: 0; pointer-events: none; }
  .stage__end {
    position: absolute; inset: 0; z-index: 3; display: grid; place-content: center; justify-items: center; gap: 0; text-align: center;
    padding: clamp(12px, 6cqi, 24px); color: #fff;
  }
  .stage__end[hidden] { display: none; }
  .stage__end:not([hidden]) { animation: noteIn 0.5s ease-out both; }
  .stage__end-title { font-family: var(--font-display); font-size: clamp(1.4rem, 9cqi, 2rem); line-height: 1.15; margin: 0 0 10px; }
  .stage__end-text { font-size: 15px; line-height: 1.5; margin: 0 auto; max-width: 26ch; color: rgba(255, 255, 255, 0.9); text-wrap: balance; }
  .stage__end-btn {
    /* (one line in the narrowest frame: an iPhone's, beside the design strip, is about 215px wide) */
    display: inline-flex; align-items: center; gap: 8px; margin: 20px 0 0; padding: 0 clamp(14px, 6cqi, 20px); height: 46px; border: 0; border-radius: 100px;
    background: #fff; color: var(--c-dark); font: inherit; font-size: clamp(13px, 5.8cqi, 15px); font-weight: 800; white-space: nowrap; cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25); animation: noteIn 0.4s ease-out both;
  }
  .stage__end-btn[hidden] { display: none; }
  .stage__end-btn :global(svg) { width: 16px; height: 16px; fill: currentColor; }
  .stage__end-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .stage__end-wait { margin: 18px auto 0; font-size: 13px; line-height: 1.5; max-width: 28ch; color: rgba(255, 255, 255, 0.75); }
  .stage__end-wait[hidden] { display: none; }
  /* While the replay is being made: a thin line under those words, filling slowly (live-stage.ts paintEndLine). Flat
     white on a soft track, never full until the replay is here; it goes with the words when Watch the replay comes */
  .stage__end-line { display: block; width: min(168px, 72cqi); height: 3px; margin: 12px auto 0; border-radius: 3px; background: rgba(255, 255, 255, 0.24); overflow: hidden; }
  .stage__end-fill { display: block; width: 100%; height: 100%; border-radius: inherit; background: #fff; transform: scaleX(0); transform-origin: left center; transition: transform 1s linear; }
  .stage__end-short { display: none; }
  /* A small frame (a short phone's, beside the design strip: an iPhone SE's is about 120px wide): the note scaled to it,
     and the button one short line, "Replay" (its name for a screen reader stays "Watch the replay") */
  @container (max-width: 179px) {
    .stage__end { padding: 10px; }
    .stage__end-title { font-size: clamp(1rem, 13cqi, 1.4rem); margin-bottom: 6px; }
    .stage__end-text { font-size: 13px; line-height: 1.4; }
    .stage__end-btn { height: 40px; margin-top: 14px; padding: 0 14px; gap: 6px; font-size: 13px; }
    .stage__end-long { display: none; }
    .stage__end-short { display: inline; }
    .stage__end-wait { margin-top: 12px; font-size: 12px; line-height: 1.4; }
    .stage__end-line { margin-top: 8px; }
  }
  /* (the smallest, an old 4-inch iPhone's: the name of the moment and what to do, the thank-you steps aside) */
  @container (max-width: 119px) {
    .stage__end { padding: 8px; }
    .stage__end-text { display: none; }
    .stage__end-btn { padding: 0 12px; margin-top: 10px; }
    .stage__end-btn :global(svg) { display: none; }
    .stage__end-wait { margin-top: 8px; }
    .stage__end-line { margin-top: 6px; height: 2px; }
  }

  .stage__tap {
    position: absolute; inset: 0; z-index: 4; display: grid; place-content: center; justify-items: center; gap: 12px;
    border: 0; background: rgba(0, 0, 0, 0.35); color: #fff; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
  }
  .stage__tap[hidden] { display: none; }
  .stage__tap-icon { width: 76px; height: 76px; border-radius: 50%; background: #fff; color: var(--c-dark); display: grid; place-items: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
  .stage__tap-icon :global(svg) { width: 32px; height: 32px; margin-left: 4px; }
  .stage__tap:focus-visible .stage__tap-icon { outline: 3px solid #fff; outline-offset: 3px; }
  /* A replay waiting for its first tap (data-start, live-stage.ts): the picture as it is, not dimmed, and in its middle one
     big ink play button, the rail's play at the size of a first press (ink, not yellow: the page's one yellow is Fund the
     next room). Gone the moment it plays; never during the live reveal */
  .stage[data-start] .stage__tap { background: none; }
  .stage[data-start] .stage__tap-word { display: none; }
  .stage[data-start] .stage__tap-icon { width: 84px; height: 84px; background: var(--c-dark); color: #fff; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28), 0 0 0 4px rgba(255, 255, 255, 0.92); transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .stage[data-start] .stage__tap-icon :global(svg) { width: 34px; height: 34px; margin-left: 5px; }
  @media (hover: hover) { .stage[data-start] .stage__tap:hover .stage__tap-icon { transform: scale(1.06); } }
  .stage[data-start] .stage__tap:active .stage__tap-icon { transform: scale(0.94); }
  /* (in the corner player, smaller) */
  .stage[data-start] .stage__picture.is-docked .stage__tap-icon { width: 52px; height: 52px; }
  .stage[data-start] .stage__picture.is-docked .stage__tap-icon :global(svg) { width: 22px; height: 22px; margin-left: 3px; }
  @media (prefers-reduced-motion: reduce) { .stage[data-start] .stage__tap-icon { transition: none; } }

  /* ── Captions line (replay) ── */
  /* Always two lines tall (a longer cue is shown a page at a time, live-stage.ts), so nothing under it ever moves */
  .stage__cc {
    margin: var(--gap) 0 0; height: calc(2 * 1.4em + 12px); overflow: hidden; display: grid; place-items: center; text-align: center;
    padding: 6px 14px; border-radius: 14px; background: var(--c-dark-deep); color: #fff; font-size: 15px; line-height: 1.4; overflow-wrap: anywhere;
  }
  .stage__cc[hidden] { display: none; }

  /* ── Bar ── */
  /* Above the yellow accent that peeks out from behind the video */
  .stage__bar, .stage__cc { position: relative; z-index: 1; }
  .stage__bar {
    margin-top: var(--gap); height: var(--bar); display: flex; align-items: center;
    padding: 0 6px 0 16px; border-radius: 100px; background: #fff; border: 1px solid var(--c-border); min-width: 0;
  }
  .stage__bar[hidden] { display: none; }
  .bar__live { display: flex; align-items: center; gap: 10px; width: 100%; min-width: 0; }
  /* Replay: play, the progress line with the time under it, then captions and full screen. The time shares the
     line's cell instead of taking a width of its own, so the line gets everything the buttons don't need, and a
     portrait video's narrow bar still holds every control (nothing ever hangs off its end) */
  .bar__replay { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-auto-flow: column; grid-auto-columns: auto; align-items: center; column-gap: 8px; width: 100%; min-width: 0; }
  .bar__replay > .seek, .bar__replay > .bar__time { grid-row: 1; grid-column: 2; }
  .bar__live[hidden], .bar__replay[hidden] { display: none; }
  .bar__status { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text); white-space: nowrap; }
  .bar__status span:last-child { overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 360px) { .stage__bar { padding-left: 12px; } }
  /* The bar's words give way by the bar's own width, not the screen's (beside a sideways phone's picture it's narrow on
     a wide screen): the viewer count's words go first, so "Live" is never squeezed out */
  @container bar (max-width: 300px) { .bar__status { font-size: 11px; letter-spacing: 0.04em; } }
  .bar__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c-text-light); position: relative; flex-shrink: 0; }
  .stage[data-onair] .bar__dot { background: var(--c-yellow); }
  .stage[data-onair][data-mode='live'] .bar__dot::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--c-yellow); opacity: 0;
    animation: live-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes live-ping { 0% { transform: scale(0.6); opacity: 0.9; } 70%, 100% { transform: scale(1.5); opacity: 0; } }
  /* The count takes the room between the status and the buttons. Short of room, its word steps aside first, then the
     number with its eye (a line that's never shown takes them): never a bare eye, never "Live" squeezed */
  .bar__count {
    flex: 1 1 0; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; column-gap: 5px; height: 20px; line-height: 20px; overflow: hidden;
    font-size: 13px; font-weight: 600; color: var(--c-text-muted); white-space: nowrap;
  }
  .bar__count::before { content: ''; flex: 0 0 0; height: 20px; margin-right: -5px; }
  .bar__count[hidden] { display: none; }
  .bar__count-n { display: inline-flex; align-items: center; gap: 6px; }
  .bar__count :global(svg) { width: 15px; height: 15px; }
  .bar__end { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  .bar__end [hidden] { display: none; }
  .bar__sound {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px 0 12px;
    border: 0; border-radius: 100px; background: var(--c-dark); color: #fff;
    font: inherit; font-size: 14px; font-weight: 800; cursor: pointer; white-space: nowrap;
    animation: soundNudge 2.8s ease-in-out 1.5s 3;
  }
  .bar__sound :global(svg) { width: 19px; height: 19px; }
  .bar__sound:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  @keyframes soundNudge { 0%, 80%, 100% { transform: none; } 88% { transform: scale(1.06); } }
  .bar__btn {
    width: 40px; height: 40px; flex-shrink: 0; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: transparent; color: var(--c-dark); transition: background 150ms ease, transform 150ms ease;
  }
  .bar__btn[hidden] { display: none; }
  .bar__btn:hover { background: var(--c-cream); }
  .bar__btn:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .bar__btn :global(svg) { width: 21px; height: 21px; }
  .bar__off, .stage[data-muted] .bar__on { display: none; }
  .bar__on, .stage[data-muted] .bar__off { display: grid; }
  .bar__heart { color: var(--c-dark); }
  .bar__heart :global(svg) { fill: var(--c-dark); }
  .bar__heart:active, .bar__heart.is-pop { transform: scale(0.84); }
  /* Others watching sent love: the heart beats (no numbers, nothing over the picture) */
  .bar__heart.is-beat { animation: heartBeat 0.6s ease-out; }
  @keyframes heartBeat { 0% { transform: none; } 25% { transform: scale(1.22); } 50% { transform: scale(0.96); } 75% { transform: scale(1.1); } 100% { transform: none; } }
  .bar__cc { font-size: 12px; font-weight: 800; letter-spacing: 0.04em; border: 1.5px solid var(--c-border); width: 40px; height: 32px; border-radius: 8px; }
  /* (the icons' own boxes, and the words that go under them in the rail: none in the bar) */
  .bar__ico { display: grid; place-items: center; }
  /* Full screen's icon: out to the corners, then, while full screen, back in (live-stage.ts names it to match) */
  /* (the round part and the word of play, captions and full screen: the rail draws them, below; anywhere else the
     button is the round part, as ever) */
  .bar__play-ico, .bar__cc-ico, .bar__full-ico { display: contents; }
  .full-in, .full-out { display: grid; place-items: center; }
  .full-out, .stage[data-fullscreen] .full-in { display: none; }
  .stage[data-fullscreen] .full-out { display: grid; }
  .bar__lbl, .bar__rise, .bar__behind { display: none; }
  /* Share and Fund the next room: in the Theater's rail only (below); anywhere else the page's own buttons do it */
  .stage .bar__act { display: none !important; }

  /* ── The rail: a live portrait picture has its controls in a slim column beside it, not in a bar under it (the
     Theater layout, Peter, Nov 17 2026): sound and full screen at the top, each with its word under it, and the heart
     at the bottom, where the hearts everyone sends float up the column beside the picture (never on it). The picture
     gets the room the bar took, so it's taller. LIVE and the number watching go under the picture on a computer
     (.stage__live, below), beside the kid's name on a phone held sideways (LivePage). live-stage.ts decides when
     (data-rail): a live portrait picture, out of full screen, on a computer or a
     phone held sideways. Never on a phone held upright: there the room's pictures stay beside the video all through the
     reveal and the controls run in the bar under both (Peter, Nov 20 2026: "why does the at 4pm drop the before pics
     and plan on the right side?!?!", then "Keep pictures beside video") ── */
  /* (the server marks the rail before the page's script runs, for any screen: so this is everything but a phone held
     upright, PHONE_UPRIGHT in src/utils/live-media.ts, where the mark does nothing) */
  @media (min-width: 1101px), (min-width: 961px) and (max-height: 1199px), (min-width: 560px) and (min-aspect-ratio: 7/4) and (max-height: 540px) {
    .stage[data-party][data-rail] {
      --rail: 56px; --rail-gap: 12px; --below: var(--under, 0px);
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--pic)) var(--rail-gap) var(--rail) minmax(0, 1fr);
      grid-template-areas: '. screen . bar .' 'under under under under under';
      width: min(var(--stage-max, 100%), calc(var(--pic) + var(--rail-gap) + var(--rail)));
    }
    .stage[data-party][data-rail] .stage__beside { display: none; }
    .stage[data-party][data-rail] .stage__bar {
      margin: 0; height: auto; padding: 0; border: 0; border-radius: 0; background: none; align-self: stretch; min-height: 0; container: none;
    }
    .stage[data-rail] .bar__live { flex-direction: column; height: 100%; gap: 0; }
    .stage[data-rail] .bar__status, .stage[data-rail] .bar__count { display: none; }
    .stage[data-rail] .bar__end { flex-direction: column; align-items: center; gap: 14px; margin: 0; width: 100%; flex: 1 1 auto; min-height: 0; }
    .stage[data-rail] .bar__btn, .stage[data-rail] .bar__sound {
      width: 100%; height: auto; padding: 0; gap: 6px; border-radius: 0; background: none; animation: none;
      display: flex; flex-direction: column; align-items: center; font: inherit; color: var(--c-text-muted);
    }
    .stage[data-rail] .bar__end > [hidden] { display: none; }
    /* One that comes (the picture starting, the sound going on, the heart once it's on air) grows in, a touch springy,
       while the others glide to their new places (live-stage.ts railChange) */
    .stage[data-rail] .bar__end > :is(button, a) { animation: railIn 420ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards; }
    @keyframes railIn { from { opacity: 0; transform: scale(0.6); } }
    .stage[data-rail] .bar__btn:hover { background: none; }
    .stage[data-rail] .bar__ico {
      width: 46px; height: 46px; border-radius: 50%; background: #fff; border: 1px solid var(--c-border); color: var(--c-dark);
      transition: transform 150ms ease, background 150ms ease, border-color 150ms ease;
    }
    .stage[data-rail] .bar__btn:hover .bar__ico { border-color: var(--c-dark); }
    .stage[data-rail] .bar__btn :global(svg), .stage[data-rail] .bar__sound :global(svg) { width: 19px; height: 19px; }
    .stage[data-rail] .bar__lbl, .stage[data-rail] .bar__txt {
      display: block; max-width: 100%; font-size: 10.5px; font-weight: 700; line-height: 1.2; text-align: center; letter-spacing: 0;
      white-space: normal; overflow-wrap: normal; color: var(--c-text-muted);
    }
    /* Behind the live moment by your own choice: Back to live is the one that matters, filled in ink like Tap for sound,
