---
import BotTrap from '../global/BotTrap.astro';
/**
 * LiveMessages.astro — messages for the family (the panel)
 * ========================================================
 * Rendered beside the video (data-place="hero"), which is where it is during
 * a live reveal, so it is already in place on first paint. Before the
 * reveal, src/utils/live-messages.ts moves it into its own section below the
 * hero (data-place="section"), where it spreads out into two columns.
 *
 * Beside the video it's a card (the Theater layout, Peter, Nov 17 2026): its
 * heading, the messages newest at the bottom like a chat, each with its
 * writer's first letter, and the box to write in at the bottom. The box asks
 * for a first name once ("Writing as"), grows with what's typed, and its
 * arrow turns ink when there's something to send. A new message warms for a
 * moment as it arrives.
 */
import { LATEST_HEART } from '../../utils/live-message-look';
const ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>';
---

<div class="msgs" data-msgs="panel" data-place="hero">
  <!-- On a phone, under the video: the newest message, one line (a tap goes to them all, below) -->
  <button class="msgs__latest" type="button" data-msgs="latest" hidden>
    <span class="msg__av" data-msgs="latest-av" aria-hidden="true"></span>
    <span class="msgs__latest-words"><span class="msgs__latest-name" data-msgs="latest-name"></span> <span class="msgs__latest-text" data-msgs="latest-text"></span></span>
  </button>
  <!-- In the Theater on a computer, beside the messages' heading under the room: "See all" and "Write", each opening the
       card in the right column (LivePage). "Write" with a pen where the column is narrow -->
  <button class="msgs__all" type="button" data-msgs="all">See all</button>
  <button class="msgs__write" type="button" data-msgs="write" aria-label="Write to the family"><svg class="msgs__write-pen" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.17 6.81a2.82 2.82 0 0 0-3.98-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z"/><path d="m15 5 4 4"/></svg><span class="msgs__write-long">Write to the family</span><span class="msgs__write-short">Write</span></button>
  <div class="msgs__head">
    <!-- (the Theater, opened from the line under the video: back to the line and the sponsors) -->
    <button class="msgs__close" type="button" data-msgs="close" aria-label="Close the messages"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
    <p class="section-label">Messages</p>
    <h2 data-msgs="heading">Messages for the family</h2>
    <p class="msgs__lead">Leave a kind note. Every message is saved and given to the family after the reveal.</p>
  </div>
  <div class="msgs__feed">
    <div class="msgs__wall" data-msgs="wall">
      <ol class="msg-list" data-msgs="list" aria-label="Messages"></ol>
      <!-- No messages yet: an invitation, in the middle of the wall (the same words as the phone's line under the video) -->
      <p class="msg-empty" data-msgs="empty"><span class="msg-empty__heart" aria-hidden="true"><Fragment set:html={LATEST_HEART} /></span><span data-msgs="empty-text">Be the first to leave a message</span></p>
    </div>
    <button class="msg-jump" type="button" data-msgs="jump" hidden>New messages</button>
  </div>
  <!-- On a phone during the watch party it's docked at the bottom of the screen (data-bottom-bar: the corner video
       player sits above it, live-stage.ts) -->
  <div class="msgs__compose" data-msgs="compose" data-bottom-bar>
    <form class="msg-form" data-msgs="form" novalidate>
      <div class="msg-box">
        <p class="msg-who">
          <label class="msg-who__label" for="msg-name">Writing as</label>
          <input class="msg-who__field" id="msg-name" name="name" type="text" maxlength="40" autocomplete="given-name" autocapitalize="words" spellcheck="false" placeholder="your first name" required />
        </p>
        <div class="msg-row">
          <label class="sr-only" for="msg-body">Your message</label>
          <textarea class="msg-body" id="msg-body" name="body" maxlength="280" rows="1" required placeholder="We are so happy for you!" enterkeyhint="send"></textarea>
          <button class="msg-send" type="submit" aria-label="Send your message" data-msgs="send"><Fragment set:html={ARROW} /></button>
        </div>
      </div>
      <BotTrap />
      <p class="msg-meta"><span class="msg-fine">Checked before it shows. First names only, please.</span><span class="msg-count" data-msgs="count" aria-hidden="true" hidden>0/280</span></p>
      <p class="remind-note" data-msgs="note" role="status" aria-live="polite"></p>
    </form>
    <p class="msg-closed" data-msgs="closed" hidden>Messages are closed for this reveal. Thank you to everyone who wrote in.</p>
  </div>
</div>

<style>
  .msgs h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.02em; margin: 8px 0 16px; }
  .msgs__lead { color: var(--c-text-muted); line-height: 1.7; max-width: 560px; margin: 0 0 8px; }
  .msgs__feed { position: relative; min-height: 0; display: flex; flex-direction: column; }
  /* (no overscroll-behavior: a swipe that reaches the wall's end moves the page; on a phone the wall is a few hundred
     pixels of the screen under the video, and it held every swipe) */
  /* Laid out from its end (column-reverse): the box opens on the newest message from the first paint, with the
     messages the server wrote in (functions/live/[[path]].js), no script needed; a short list still sits at the top
     (the list's auto margin takes the room under it). live-messages.ts scrolls it with that in mind, and keeps a
     reader's place itself when a message comes in (overflow-anchor: none, the same in every browser) */
  .msgs__wall { display: flex; flex-direction: column-reverse; border-radius: var(--border-radius-lg); padding: 16px; overflow-y: auto; overflow-anchor: none; scroll-behavior: smooth; }
  .msg-jump {
    position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%);
    border: 0; border-radius: 100px; padding: 8px 16px; background: var(--c-dark); color: #fff;
    font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }
  .msg-jump[hidden] { display: none; }
  .msg-jump:focus-visible { outline: 2px solid var(--c-yellow); outline-offset: 2px; }
  .msg-empty { color: var(--c-text-muted); margin: 0; padding: 8px 4px; }
  .msg-empty[hidden] { display: none; }
  .msg-empty__heart { display: none; }
  /* Beside the video: in the middle of the empty wall, under a heart (the empty list steps aside so it's centred) */
  .msgs[data-place='hero'] .msg-list:empty { display: none; }
  .msgs[data-place='hero'] .msg-empty:not([hidden]) { margin: auto; padding: 0; max-width: 24ch; display: grid; justify-items: center; gap: 12px; text-align: center; font-size: 15px; line-height: 1.5; text-wrap: balance; }
  .msgs[data-place='hero'] .msg-empty__heart { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--c-dark); color: #fff; }
  .msgs[data-place='hero'] .msg-empty__heart :global(svg) { width: 20px; height: 20px; }
  .msg-closed { color: var(--c-text-muted); line-height: 1.6; }
  .msg-closed[hidden] { display: none; }

  /* ── One message: the writer's first letter, then their name and words in a bubble ── */
  .msg-list { list-style: none; margin: 0 0 auto; padding: 0; display: grid; gap: 12px; }
  .msg-list :global(.msg) { display: flex; align-items: flex-start; gap: 12px; animation: msgIn 360ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .msg-list :global(.msg__av) {
    flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
    font-size: 14px; font-weight: 800; line-height: 1; background: var(--c-dark); color: #fff;
  }
  /* (each writer's letter a colour of their own, from the page's quiet ones, never yellow: the live page's one yellow is
     Fund the next room, Peter, Nov 19 2026. The same in the server's markup and the script's) */
  .msg-list :global(.msg__av[data-tone='1']) { background: #E6E0D0; color: var(--c-dark); }
  .msg-list :global(.msg__av[data-tone='2']) { background: #ECE8DC; color: var(--c-text); }
  .msg-list :global(.msg__av[data-tone='3']) { background: #D3CCB8; color: var(--c-dark); }
  .msg-list :global(.msg__av[data-tone='4']) { background: #fff; color: var(--c-text); box-shadow: inset 0 0 0 1px var(--c-border); }
  .msg-list :global(.msg__card) {
    min-width: 0; flex: 1; background: var(--c-cream); border: 1px solid var(--c-border); border-radius: 4px 16px 16px 16px; padding: 9px 14px 10px;
  }
  .msg-list :global(.msg__name) { display: block; font-weight: 700; font-size: 13.5px; color: var(--c-dark); }
  .msg-list :global(.msg__body) { margin: 2px 0 0; font-size: 15px; line-height: 1.5; color: var(--c-text); overflow-wrap: anywhere; text-wrap: pretty; }
  /* Just arrived: it rises in and its bubble warms for a moment, then settles (never yellow: one yellow button) */
  .msg-list :global(.msg.is-new .msg__card) { animation: msgGlow 2.4s ease-out both; }
  @keyframes msgIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes msgGlow { 0%, 35% { background: #F3EEDF; border-color: #CFC8B4; } 100% { background: var(--c-cream); border-color: var(--c-border); } }

  /* ── The box to write in: "Writing as" and a first name, then the message and its arrow ── */
  .msg-form { display: grid; gap: 8px; max-width: 520px; }
  .msg-form[hidden] { display: none; }
  .msg-box {
    border: 1.5px solid #DCD7C9; border-radius: 20px; background: #fff; padding: 4px 6px 6px 16px;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .msg-box:focus-within { border-color: var(--c-dark); box-shadow: 0 0 0 3px var(--c-yellow-soft); }
  /* The box shows where you're typing (above): the site's own ring would draw a second one inside it */
  .msg-who__field:focus-visible, .msg-body:focus-visible { outline: none; box-shadow: none; }
  .msg-who { display: flex; align-items: center; gap: 6px; margin: 0 10px 0 0; padding: 2px 0 3px; border-bottom: 1px solid var(--c-border); font-size: 14px; color: var(--c-text-muted); }
  .msg-who__label { flex: none; font-weight: 500; cursor: text; }
  /* (16px: smaller, an iPhone zooms the whole page in to type in it, and leaves it zoomed) */
  .msg-who__field {
    flex: 1; min-width: 0; padding: 4px 0; border: 0; background: transparent; outline: none;
    font: inherit; font-size: 16px; font-weight: 700; color: var(--c-text);
  }
  /* What goes in a field before you type is a shade lighter than what you type, so it never reads as written already
     (still 4.7:1 on white) */
  .msg-who__field::placeholder, .msg-body::placeholder { color: color-mix(in srgb, var(--c-text-muted) 85%, #fff); font-weight: 400; opacity: 1; }
  /* (empty, it's one line however long the kid's name makes the example: a second line was cut in half by the box) */
  .msg-body:placeholder-shown { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msg-row { display: flex; align-items: flex-end; gap: 8px; }
  .msg-body {
    flex: 1; min-width: 0; height: 44px; max-height: 132px; padding: 11px 0; border: 0; background: transparent; outline: none; resize: none;
    font: inherit; font-size: 16px; line-height: 22px; color: var(--c-text); overflow-y: auto;
  }
  .msg-send {
    flex: none; width: 42px; height: 42px; margin: 1px 0; border: 0; border-radius: 14px; display: grid; place-items: center; cursor: pointer;
    background: var(--c-warm-gray); color: var(--c-text-muted); transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .msg-send :global(svg) { width: 19px; height: 19px; }
  .msg-send.is-ready { background: var(--c-dark); color: #fff; }
  .msg-send:active { transform: scale(0.9); }
  .msg-send:focus-visible { outline: 2px solid var(--c-dark); outline-offset: 2px; }
  .msg-send:disabled { cursor: progress; }
  .msg-meta { display: flex; justify-content: space-between; gap: 12px; margin: 0 4px; font-size: 12px; color: var(--c-text-light); }
  .msg-fine { min-width: 0; }
  .msg-count { flex: none; font-variant-numeric: tabular-nums; }
  .msg-count[hidden] { display: none; }
  .remind-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .remind-note { font-size: 14px; color: var(--c-text-muted); min-height: 1.4em; margin: 0 4px; }
  .remind-note--error { color: var(--c-text); font-weight: 600; }

  /* In its own section: heading and form on the left, the wall on the right */
  .msgs[data-place='section'] {
    display: grid; grid-template-columns: 0.9fr 1.1fr; grid-template-rows: auto 1fr;
    grid-template-areas: 'head feed' 'compose feed'; column-gap: clamp(32px, 5vw, 72px); row-gap: 8px; align-items: start;
  }
  .msgs[data-place='section'] .msgs__head { grid-area: head; }
  .msgs[data-place='section'] .msgs__compose { grid-area: compose; }
  .msgs[data-place='section'] .msgs__feed { grid-area: feed; }
  .msgs[data-place='section'] .msgs__wall { max-height: 560px; background: var(--c-cream); }

  /* ── Beside the video: a card that fills its column ── */
  .msgs[data-place='hero'] {
    display: flex; flex-direction: column; flex: 1 0 auto; text-align: left; min-height: 0;
    background: #fff; border: 1px solid var(--c-border); border-radius: 24px; overflow: hidden; box-shadow: 0 20px 50px rgba(30, 31, 37, 0.06);
  }
  .msgs[data-place='hero'] .msgs__head { padding: 20px 22px 14px; border-bottom: 1px solid var(--c-border); }
  .msgs[data-place='hero'] .section-label { display: none; }
  .msgs[data-place='hero'] h2 { font-size: 1.3rem; letter-spacing: -0.01em; margin: 0; }
  .msgs[data-place='hero'] .msgs__lead { font-size: 13px; line-height: 1.5; margin: 6px 0 0; }
  .msgs[data-place='hero'] .msgs__feed { flex: 1 1 0; min-height: 150px; }
  .msgs[data-place='hero'] .msgs__wall { flex: 1 1 auto; min-height: 0; border-radius: 0; padding: 16px 20px; }
  /* A short list sits at the bottom, by the box you write in, as a chat's does */
  .msgs[data-place='hero'] .msg-list { margin: auto 0 0; }
  .msgs[data-place='hero'] .msgs__compose { padding: 14px 16px 12px; border-top: 1px solid var(--c-border); background: #fff; }
  /* (one column that can be narrower than the name field's own width: the Theater's card is 260px at its narrowest) */
  .msgs[data-place='hero'] .msg-form { max-width: none; gap: 6px; grid-template-columns: minmax(0, 1fr); }
  .msgs[data-place='hero'] .msg-closed { margin: 0; font-size: 14px; }
  .msgs[data-place='hero'] .remind-note { min-height: 0; font-size: 13px; }
  .msgs[data-place='hero'] .remind-note:empty { display: none; }

  /* The newest message, one line: under the video on a phone held upright (below) and in the Theater on a computer */
  .msgs__latest { display: none; }
  .msgs__write, .msgs__close, .msgs__all { display: none; }
  .msgs__latest .msg__av {
    flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 12.5px; font-weight: 800; line-height: 1;
    background: var(--c-dark); color: #fff;
  }
  .msgs__latest .msg__av[data-tone='1'] { background: #E6E0D0; color: var(--c-dark); }
  .msgs__latest .msg__av[data-tone='2'] { background: #ECE8DC; color: var(--c-text); }
  .msgs__latest .msg__av[data-tone='3'] { background: #D3CCB8; color: var(--c-dark); }
  .msgs__latest .msg__av[data-tone='4'] { background: #fff; color: var(--c-text); box-shadow: inset 0 0 0 1px var(--c-border); }
  /* (no box of its own but in the Theater, below: on a phone the name and the message are the line's own, as ever) */
  .msgs__latest-words { display: contents; }
  .msgs__latest-name { flex: none; max-width: 40%; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .msgs__latest-text { min-width: 0; flex: 1; color: var(--c-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .msgs__latest.is-new { animation: latestIn 2.4s ease-out; }
  @keyframes latestIn { 0% { background: #F3EEDF; border-color: #CFC8B4; transform: translateY(6px); opacity: 0.4; } 12% { transform: none; opacity: 1; } 35% { background: #F3EEDF; border-color: #CFC8B4; } 100% { background: #fff; border-color: var(--c-border); } }

  /* ── The Theater on a computer with the build's sponsors (LivePage, LiveSponsors; Peter, Nov 18 2026: "priority of
     screen should be the reveal, plans/before and sponsors"; one surface, Nov 19 2026): the messages under the room, on
     the panel itself (nothing boxed): their heading in small capitals with "Write to the family" beside it (or, once
     they're closed, "See all"), then the newest two, a line each: its writer's letter, name and words. A tap on a message, See all or Write opens every
     message and the box to write in, in the sponsors' column (the hero's data-msgs-open), its × back. (The Theater's
     width: DESK, src/utils/live-media.ts) ── */
  @media (min-width: 1200px) {
    :global(.hero[data-party][data-orientation='portrait']) .msgs[data-place='hero'] { background: var(--c-cream); border: 1px solid var(--c-border); border-radius: 22px; box-shadow: none; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] {
      display: grid; grid-template-columns: minmax(0, 1fr) auto auto; grid-template-areas: 'head all write' 'feed feed feed'; align-items: center;
      gap: 8px 14px; min-height: 0; padding: 0; box-sizing: border-box; overflow: hidden; background: none; border: 0; border-radius: 0;
    }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] > :is(.msgs__compose, .msgs__latest) { display: none; }
    /* (its heading as the sponsors': small capitals) */
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__head { grid-area: head; min-width: 0; padding: 0; margin: 0; border: 0; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__head > :not(h2) { display: none; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__head h2 { margin: 0; font-family: inherit; font-size: 11px; font-weight: 800; letter-spacing: 0.14em; line-height: 1.3; text-transform: uppercase; color: var(--c-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* The newest two: no bubbles, the words on the panel, a line each (the room above has the column's height) */
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__feed { grid-area: feed; flex: none; min-height: 0; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__wall { padding: 0; overflow: hidden; border-radius: 0; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list { gap: 8px; margin: 0; grid-template-columns: minmax(0, 1fr); }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list > :global(:not(:nth-last-child(-n + 2))) { display: none; }
    /* (a tall screen, with the room: the newest three) */
    @media (min-height: 1000px) { :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list > :global(:nth-last-child(3)) { display: flex; } }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg) { gap: 10px; align-items: center; cursor: pointer; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg__av) { width: 26px; height: 26px; font-size: 11.5px; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg__card) {
      background: none; border: 0; border-radius: 0; padding: 0; animation: none;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 14px; line-height: 1.45;
    }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg__name) { display: inline; font-size: 14px; margin-right: 0.35em; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg__body) { display: inline; margin: 0; font-size: 14px; color: var(--c-text-muted); text-wrap: nowrap; white-space: nowrap; }
    @media (hover: hover) { :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-list :global(.msg:hover .msg__name) { text-decoration: underline; text-underline-offset: 3px; } }
    /* No messages yet: the invitation, one quiet line */
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-empty:not([hidden]) { margin: 0; padding: 0; max-width: none; display: block; text-align: left; font-size: 14px; }
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msg-empty__heart { display: none; }
    /* See all: words; Write: ink on white, never yellow (the Theater's one yellow button is Fund the next room) */
    :global(.hero[data-party][data-orientation='portrait']:has(.lsp:not([hidden])):not([data-msgs-open])) .msgs[data-place='hero'] .msgs__all {
      grid-area: all; display: inline-flex; align-items: center; height: 32px; padding: 0 2px; border: 0; background: none; color: var(--c-text);
      font: inherit; font-size: 13.5px; font-weight: 700; white-space: nowrap; cursor: pointer; text-decoration: underline; text-decoration-color: var(--c-border); text-underline-offset: 4px; text-decoration-thickness: 2px;
    }
