---
/**
 * One question of the Advisory Board application (src/pages/advisory-board/apply.astro),
 * from functions/api/_advisory-form.js. The page's script reads and writes it by its
 * data-field and its input's name.
 */
import { OVERVIEW_PDF } from '../../../functions/api/_advisory-form.js';

interface Props { f: any }
const { f } = Astro.props;
const fid = (id: string) => `adv-${id}`;
const described = [f.hint && `${fid(f.id)}-hint`, `${fid(f.id)}-err`].filter(Boolean).join(' ');
---
<div class={`adv-field adv-field--${f.type}`} data-field={f.id} data-show-if={f.showIf ? JSON.stringify(f.showIf) : undefined} hidden={!!f.showIf}>
  {f.type === 'choice' ? (
    <fieldset aria-describedby={described}>
      <legend class="adv-label">{f.label}{!f.required && <span class="adv-optional">{' optional'}</span>}</legend>
      {f.hint && <p class="adv-hint" id={`${fid(f.id)}-hint`}>{f.hint}</p>}
      <div class={`adv-choices${f.options.length <= 3 && f.options.every((o: string) => o.length <= 6) ? ' adv-choices--short' : ''}`}>
        {f.options.map((o: string) => (
          <label class="adv-choice"><input type="radio" name={f.id} value={o} /><span class="adv-choice-box" aria-hidden="true"></span><span class="adv-choice-text">{o}</span></label>
        ))}
      </div>
    </fieldset>
  ) : f.type === 'photo' ? (
    <>
      <span class="adv-label" id={`${fid(f.id)}-label`}>{f.label}{!f.required && <span class="adv-optional">{' optional'}</span>}</span>
      {f.hint && <p class="adv-hint" id={`${fid(f.id)}-hint`}>{f.hint}</p>}
      {/* The page's script (advisory-photo.js) makes it work: the photo drawn as a JPEG, shown here, kept on this device */}
      <div class="adv-photo" data-photo={f.id} data-state="empty">
        <div class="adv-photo-frame" aria-hidden="true">
          <img class="adv-photo-img" alt="" hidden />
          <svg class="adv-photo-blank" viewBox="0 0 48 48"><circle cx="24" cy="18" r="8" /><path d="M8.5 41.5c1.8-8.2 8-13 15.5-13s13.7 4.8 15.5 13" /></svg>
          <span class="adv-photo-spin" hidden></span>
        </div>
        <div class="adv-photo-side">
          <div class="adv-photo-btns">
            <label class="btn btn-outline-dark adv-photo-pick">
              <input type="file" id={fid(f.id)} name={`${f.id}-file`} accept="image/*,.heic,.heif"
                aria-labelledby={`${fid(f.id)}-label ${fid(f.id)}-pick`} aria-describedby={[f.hint && `${fid(f.id)}-hint`, `${fid(f.id)}-status`, `${fid(f.id)}-err`].filter(Boolean).join(' ')} />
              <span id={`${fid(f.id)}-pick`} data-photo-pick>Choose a photo</span>
            </label>
            <button type="button" class="adv-linkbtn adv-photo-remove" data-photo-remove aria-label="Remove headshot" hidden>Remove</button>
          </div>
          <p class="adv-photo-status" id={`${fid(f.id)}-status`} data-photo-status aria-live="polite"></p>
          {/* For a mouse (a phone has none); not read out, the button says what to do */}
          <p class="adv-photo-drag" aria-hidden="true">or drag one here</p>
        </div>
      </div>
    </>
  ) : f.type === 'check' ? (
    <label class="adv-check">
      <input type="checkbox" name={f.id} id={fid(f.id)} aria-describedby={`${fid(f.id)}-err`} />
      <span>{f.label} <a href={OVERVIEW_PDF} target="_blank" rel="noopener noreferrer">Open the overview (PDF)</a></span>
    </label>
  ) : (
    <>
      <label class="adv-label" for={fid(f.id)}>{f.label}{!f.required && <span class="adv-optional">{' optional'}</span>}</label>
      {f.hint && <p class="adv-hint" id={`${fid(f.id)}-hint`}>{f.hint}</p>}
      {f.type === 'textarea' ? (
        <textarea id={fid(f.id)} name={f.id} rows={f.rows || 4} maxlength={f.max} autocomplete={f.autocomplete || 'off'} aria-describedby={described}></textarea>
      ) : f.type === 'address' ? (
        <div class="adv-suggest-wrap">
          <input id={fid(f.id)} name={f.id} type="text" maxlength={f.max} autocomplete={f.autocomplete || 'off'} autocapitalize="words" spellcheck="false" enterkeyhint="next"
            role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${fid(f.id)}-suggest`} aria-describedby={described} />
          <ul class="adv-suggest" id={`${fid(f.id)}-suggest`} role="listbox" aria-label="Suggested addresses" hidden></ul>
        </div>
      ) : (
        <input id={fid(f.id)} name={f.id} type={f.type} maxlength={f.max} autocomplete={f.autocomplete || 'off'} enterkeyhint="next"
          inputmode={f.type === 'tel' ? 'tel' : f.type === 'email' ? 'email' : f.type === 'url' ? 'url' : undefined}
          aria-describedby={described} />
      )}
    </>
  )}
  <p class="adv-error" id={`${fid(f.id)}-err`} hidden></p>
</div>
